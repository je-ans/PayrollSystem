@model EmployeeLoanViewModel

<div class="container-fluid">
    <form asp-action="Delete" method="post" asp-antiforgery="true" id="employeeLoanDeleteForm">
        <input type="hidden" asp-for="Id" />
        <div class="text-center my-3">
            <i class="fa fa-exclamation-triangle text-danger fa-3x"></i>
        </div>
        <h5 class="text-center mb-3">Are you sure you want to delete this employee loan?</h5>
        <h5 class="font-weight-bold text-danger text-center">
            <strong>@Model.LoanName — @Model.EmployeeName</strong>
        </h5>
        <p class="text-muted text-center mb-2">Principal: ₱@Model.PrincipalAmount.ToString("N2") · Balance: ₱@Model.RemainingBalance.ToString("N2")</p>
        <p class="text-muted text-center">This action cannot be undone.</p>
    </form>
</div>

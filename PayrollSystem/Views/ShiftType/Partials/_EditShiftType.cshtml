@model ShiftTypeViewModel
@{
    ViewData["FormPrefix"] = "edit";
}

<link rel="stylesheet" href="~/css/dtr-modals.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/shift-type.css" asp-append-version="true" />

<form asp-action="EditShiftType" method="post" asp-antiforgery="true" id="shiftTypeForm" class="dm-modal st-shift-form">
    <input type="hidden" asp-for="Id" />
    <span asp-validation-summary="All" class="text-danger validation-summary"></span>
    <partial name="Partials/_ShiftTypeFormFields" model="Model" view-data="ViewData" />
</form>

@model ShiftTypeViewModel

<div class="text-center my-3">
    <i class="fa fa-ban text-danger fa-3x"></i>
</div>
<h5 class="text-center mb-3">Cannot Delete Shift Type</h5>
<h5 class="font-weight-bold text-danger text-center">
    <strong>@Model.Label (@Model.Code)</strong>
</h5>
<p class="text-muted text-center">This shift type cannot be deleted because it is used on work schedules. You can deactivate it instead.</p>

@model ShiftTypeViewModel
@{
    var prefix = ViewData["FormPrefix"]?.ToString() ?? "shift";
}

<div class="dm-alert-banner dm-alert-banner--info mb-3">
    <i class="fas fa-info-circle"></i>
    <div>
        <strong>Shift codes</strong>
        <span>Drive work schedules, DTR pairing, and credited hours. Use <em>Leave / Off</em> for VL, rest days, and other non-duty codes.</span>
    </div>
</div>

<div class="dm-section">
    <div class="dm-section-header">
        <i class="fas fa-tag"></i>
        Basic Information
    </div>
    <div class="dm-section-body">
        <div class="st-field-grid st-field-grid--2">
            <div class="st-field">
                <label asp-for="Code" class="dm-form-label">Code <span class="text-danger">*</span></label>
                <input asp-for="Code" type="text" class="form-control form-control-sm dm-form-control" required maxlength="20" />
                <span asp-validation-for="Code" class="text-danger validation-message"></span>
            </div>
            <div class="st-field">
                <label asp-for="Label" class="dm-form-label">Label <span class="text-danger">*</span></label>
                <input asp-for="Label" type="text" class="form-control form-control-sm dm-form-control" required maxlength="100" />
                <span asp-validation-for="Label" class="text-danger validation-message"></span>
            </div>
        </div>

        <div class="st-field-grid st-field-grid--3">
            <div class="st-field">
                <label asp-for="Hours" class="dm-form-label">Credited Hours <span class="text-danger">*</span></label>
                <input asp-for="Hours" type="number" step="0.01" min="0" max="24" class="form-control form-control-sm dm-form-control shift-hours" required />
                <span asp-validation-for="Hours" class="text-danger validation-message"></span>
            </div>
            <div class="st-field">
                <label asp-for="SortOrder" class="dm-form-label">Sort Order</label>
                <input asp-for="SortOrder" type="number" class="form-control form-control-sm dm-form-control" />
                <span asp-validation-for="SortOrder" class="text-danger validation-message"></span>
            </div>
            <div class="st-field">
                <label asp-for="ColorHex" class="dm-form-label">Display Color</label>
                <div class="st-color-field">
                    <span class="st-color-swatch shift-color-swatch" style="background-color: @Model.ColorHex;"></span>
                    <input asp-for="ColorHex" type="color" class="form-control form-control-color shift-color-input" />
                </div>
                <span asp-validation-for="ColorHex" class="text-danger validation-message"></span>
            </div>
        </div>

        <div class="st-switch-row st-switch-row--2">
            <div class="st-switch-chip">
                <div class="custom-control custom-switch">
                    <input class="custom-control-input shift-is-leave" asp-for="IsLeave" id="@(prefix)IsLeave" />
                    <label class="custom-control-label" for="@(prefix)IsLeave">Leave / Off</label>
                </div>
            </div>
            <div class="st-switch-chip">
                <div class="custom-control custom-switch">
                    <input class="custom-control-input" asp-for="IsActive" id="@(prefix)IsActive" />
                    <label class="custom-control-label" for="@(prefix)IsActive">Active</label>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Partials/_ScheduleFields" model="Model" view-data="ViewData" />

@model IEnumerable<DayType>

@{
    ViewData["Title"] = "Day Type";
    ViewBag.ActiveMenu = "DayType";
    ViewBag.ActiveLink = "DayType";
    ViewBag.ActiveMainMenu = "";
}

<div class="card card-outline rounded-0 card-primary mx-2 px-2">
    <div class="card-header d-flex align-items-center">
        <div class="flex-grow-1 d-flex justify-content-start">
            <h3 class="card-title m-0">Day Type List</h3>
        </div>
        <div class="card-tools d-flex align-items-center">
            <a href="javascript:void(0)" class="btn btn-primary open-modal"
               data-title="Add Day Type"
               data-url="/DayType/CreateDayType"
               data-modal-type="create"
               data-toogle="tooltip"
               title="Add Day Type">
                <i class="fas fa-plus"></i>
                <span class="d-none d-lg-inline">Add Day Type</span>
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="container-fluid">
            <table class="table table-hover table-striped table-bordered" id="myTable" width="100%">
                <thead>
                    <tr class="text-center">
                        <th>No.</th>
                        <th>Code</th>
                        <th>Day Type Name</th>
                        <th>Basic</th>
                        <th>OT</th>
                        <th>ND</th>
                        <th>Effective From</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var index = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@index</td>
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td class="text-end">@item.BasicMultiplier.ToString("N4")</td>
                                <td class="text-end">@item.OvertimeMultiplier.ToString("N4")</td>
                                <td class="text-end">@item.NightDifferentialMultiplier.ToString("N4")</td>
                                <td class="text-center">@item.EffectiveFrom.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                        <i class="@(item.IsActive ? "fa fa-check-circle text-white" : "fa fa-times-circle text-white")"></i>
                                        @(item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td align="center">
                                    <button type="button" class="btn btn-flat p-1 btn-default btn-sm dropdown-toggle dropdown-icon" data-toggle="dropdown">
                                        Action
                                        <span class="sr-only">Toggle Dropdown</span>
                                    </button>
                                    <div class="dropdown-menu" role="menu">
                                        <a href="javascript:void(0)" class="dropdown-item open-modal"
                                           data-title="Day Type Details"
                                           data-url="/DayType/ViewDayType/@item.Id"
                                           data-modal-type="view"
                                           data-size="modal-lg">
                                            <i class="fa fa-eye mr-2 text-dark"></i>
                                            <span>View Day Type</span>
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a href="javascript:void(0)" class="dropdown-item open-modal"
                                           data-title="Edit Day Type"
                                           data-url="/DayType/EditDayType/@item.Id"
                                           data-modal-type="edit"
                                           data-size="modal-lg">
                                            <i class="fa fa-edit mr-2 text-primary"></i>
                                            <span>Edit Day Type</span>
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a href="javascript:void(0)" class="dropdown-item open-modal"
                                           data-title="Delete Day Type"
                                           data-url="/DayType/DeleteDayType/@item.Id"
                                           data-modal-type="delete_data">
                                            <i class="fa fa-trash mr-2 text-danger"></i>
                                            <span>Delete Day Type</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model PayrollSystem.ViewModels.WorkSchedule.WorkScheduleOverviewViewModel
@using PayrollSystem.Models
@{
    var pageTitle = Model.IsReadOnly ? "Office Schedule" : "Monthly Schedule";
    ViewData["Title"] = $"{pageTitle} – {Model.Year}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var canShowGrid = Model.OrganizationStructureId > 0 && Model.EmployeeCount > 0;
    var emptyState = Model.OrganizationStructureId <= 0 ? "no-org"
        : Model.EmployeeCount == 0 ? "no-employees"
        : null;

    var yearFilled = Model.Months.Count(m => m.Status != null && m.EntryCount > 0);
    var yearPct = Model.Months.Count > 0 ? (int)Math.Round(yearFilled * 100.0 / 12) : 0;

    string MonthCardClass(WorkScheduleStatus? status) => status switch
    {
        WorkScheduleStatus.Approved => "ws-month-status-approved",
        WorkScheduleStatus.Submitted => "ws-month-status-submitted",
        WorkScheduleStatus.Rejected => "ws-month-status-rejected",
        WorkScheduleStatus.Draft => "ws-month-status-draft",
        null => "ws-month-status-empty",
        _ => "ws-month-status-empty"
    };

    string MonthIconClass(WorkScheduleStatus? status) => status switch
    {
        WorkScheduleStatus.Approved => "ws-month-icon-approved",
        WorkScheduleStatus.Submitted => "ws-month-icon-submitted",
        WorkScheduleStatus.Rejected => "ws-month-icon-rejected",
        WorkScheduleStatus.Draft => "ws-month-icon-draft",
        _ => "ws-month-icon-empty"
    };

    string MonthIcon(WorkScheduleStatus? status) => status switch
    {
        WorkScheduleStatus.Approved => "fa-check-circle",
        WorkScheduleStatus.Submitted => "fa-paper-plane",
        WorkScheduleStatus.Rejected => "fa-times-circle",
        WorkScheduleStatus.Draft => "fa-edit",
        _ => "fa-calendar-plus"
    };
}

<link rel="stylesheet" href="~/css/work-schedule.css" asp-append-version="true" />

<section class="content ws-page">
    <div class="container-fluid">
        <div class="card card-outline rounded-0 card-primary mx-2 px-2 ws-overview-card">
            <div class="card-header d-flex align-items-center flex-wrap gap-2">
                <div class="flex-grow-1">
                    <h3 class="card-title m-0">
                        <i class="fas fa-calendar-alt mr-2"></i>@pageTitle
                    </h3>
                    <p class="ws-intro mt-1 mb-0">
                        @if (!string.IsNullOrWhiteSpace(Model.OrganizationUnitDisplay))
                        {
                            <span>@Model.OrganizationUnitDisplay — </span>
                        }
                        Plan and track shift assignments for each month of @Model.Year.
                    </p>
                </div>
                @if (canShowGrid)
                {
                    <div class="card-tools">
                        <span class="badge badge-light border text-muted">
                            <i class="fas fa-users mr-1"></i>@Model.EmployeeCount employee@(Model.EmployeeCount == 1 ? "" : "s")
                        </span>
                    </div>
                }
            </div>

            <div class="card-body">
                <!-- Filters -->
                <div class="ws-overview-filters">
                    <form method="get"
                          asp-controller="@Model.DetailController"
                          asp-action="Index"
                          id="wsOverviewFilterForm"
                          class="form-row align-items-end">
                        @if (Model.OrganizationUnits.Count > 1)
                        {
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group mb-2 mb-md-0">
                                    <label for="wsOrgUnit" class="mb-1 font-weight-semibold">Organization Unit</label>
                                    <select name="organizationStructureId"
                                            id="wsOrgUnit"
                                            class="form-control select2 general-select"
                                            required>
                                        @foreach (var unit in Model.OrganizationUnits)
                                        {
                                            if (unit.Id == Model.OrganizationStructureId)
                                            {
                                                <option value="@unit.Id" selected>@unit.DisplayText</option>
                                            }
                                            else
                                            {
                                                <option value="@unit.Id">@unit.DisplayText</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        }
                        else if (Model.OrganizationStructureId > 0)
                        {
                            <input type="hidden" name="organizationStructureId" value="@Model.OrganizationStructureId" />
                        }

                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="form-group mb-2 mb-md-0">
                                <label for="wsYear" class="mb-1 font-weight-semibold">Year</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <button type="button" class="btn btn-outline-secondary" id="wsYearPrev" title="Previous year">
                                            <i class="fas fa-chevron-left"></i>
                                        </button>
                                    </div>
                                    <input type="number"
                                           name="year"
                                           id="wsYear"
                                           value="@Model.Year"
                                           class="form-control text-center"
                                           min="2020"
                                           max="2099" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-secondary" id="wsYearNext" title="Next year">
                                            <i class="fas fa-chevron-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-3 col-sm-6">
                            <div class="form-group mb-0">
                                <label class="mb-1 d-none d-md-block">&nbsp;</label>
                                <button type="submit" class="btn btn-primary btn-block" id="wsOverviewViewBtn">
                                    <i class="fas fa-search mr-1"></i> View
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                @if (canShowGrid)
                {
                    <div class="ws-year-progress">
                        <i class="fas fa-chart-line"></i>
                        <span><strong>@Model.ApprovedCount</strong> of 12 months approved</span>
                        <div class="ws-year-progress-bar" title="@yearPct% of months started">
                            <div class="ws-year-progress-fill" style="width: @(yearPct)%"></div>
                        </div>
                        <span class="text-muted small">@yearPct%</span>
                    </div>

                    <!-- Summary stats -->
                    <div class="ws-overview-summary row g-2 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="ws-stat-card ws-stat-approved">
                                <div class="ws-stat-icon"><i class="fas fa-check-circle"></i></div>
                                <div class="ws-stat-value">@Model.ApprovedCount</div>
                                <div class="ws-stat-label">Approved</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="ws-stat-card ws-stat-submitted">
                                <div class="ws-stat-icon"><i class="fas fa-paper-plane"></i></div>
                                <div class="ws-stat-value">@Model.SubmittedCount</div>
                                <div class="ws-stat-label">Submitted</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="ws-stat-card ws-stat-draft">
                                <div class="ws-stat-icon"><i class="fas fa-edit"></i></div>
                                <div class="ws-stat-value">@Model.DraftCount</div>
                                <div class="ws-stat-label">Draft / Rejected</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="ws-stat-card ws-stat-empty">
                                <div class="ws-stat-icon"><i class="fas fa-calendar-plus"></i></div>
                                <div class="ws-stat-value">@Model.NotStartedCount</div>
                                <div class="ws-stat-label">Not Started</div>
                            </div>
                        </div>
                    </div>

                    <!-- Month grid -->
                    <div class="ws-month-grid">
                        @foreach (var month in Model.Months)
                        {
                            var daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);
                            var expected = month.EmployeeCount * daysInMonth;
                            var pct = expected > 0 ? Math.Min(100, (int)Math.Round(month.EntryCount * 100.0 / expected)) : 0;

                            <a asp-controller="@Model.DetailController"
                               asp-action="Detail"
                               asp-route-month="@month.Month"
                               asp-route-year="@month.Year"
                               asp-route-organizationStructureId="@Model.OrganizationStructureId"
                               class="ws-month-card @MonthCardClass(month.Status) @(month.IsCurrentMonth ? "ws-month-current" : "")">
                                <div class="ws-month-card-header">
                                    <span class="ws-month-name">@month.MonthName</span>
                                    @if (month.IsCurrentMonth)
                                    {
                                        <span class="badge badge-primary badge-sm">Current</span>
                                    }
                                </div>
                                <div class="ws-month-card-body">
                                    <div class="ws-month-status-row">
                                        <span class="ws-month-status-icon @MonthIconClass(month.Status)">
                                            <i class="fas @MonthIcon(month.Status)"></i>
                                        </span>
                                        <span class="badge @month.StatusBadgeClass">@month.StatusLabel</span>
                                    </div>
                                    @if (month.EmployeeCount > 0 && month.Status != null)
                                    {
                                        <div class="ws-month-progress-bar" title="@month.ProgressLabel">
                                            <div class="ws-month-progress-fill" style="width: @(pct)%"></div>
                                        </div>
                                    }
                                    <span class="ws-month-progress">@month.ProgressLabel</span>
                                </div>
                                <div class="ws-month-card-footer text-muted">
                                    @if (month.LastModifiedAt.HasValue)
                                    {
                                        <span><i class="far fa-clock mr-1"></i>Updated @month.LastModifiedAt.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span><i class="fas fa-arrow-right mr-1"></i>Click to @(Model.IsReadOnly ? "view" : "open")</span>
                                    }
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="ws-empty-state" id="wsEmptyState">
                        @if (emptyState == "no-org")
                        {
                            <div class="ws-empty-icon ws-empty-icon-info">
                                <i class="fas fa-sitemap"></i>
                            </div>
                            <h5 class="ws-empty-title">Select an organization unit</h5>
                            <p class="ws-empty-text">
                                Choose a unit from the filter above to see all monthly schedules for @Model.Year.
                            </p>
                        }
                        else if (emptyState == "no-employees")
                        {
                            <div class="ws-empty-icon ws-empty-icon-warning">
                                <i class="fas fa-user-slash"></i>
                            </div>
                            <h5 class="ws-empty-title">No employees in this unit</h5>
                            <p class="ws-empty-text">
                                Assign employees with a <strong>primary</strong> organization assignment to
                                <em>@Model.OrganizationUnitDisplay</em> before building schedules.
                            </p>
                            @if (!Model.IsReadOnly)
                            {
                                <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">
                                    <i class="fas fa-users mr-1"></i> Go to Employees
                                </a>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<div id="wsPageLoading" class="ws-page-loading" aria-hidden="true">
    <div class="ws-page-loading-inner">
        <div class="ws-spinner" aria-hidden="true"></div>
        <p class="ws-page-loading-text">Loading schedules…</p>
    </div>
</div>

@section Scripts {
    <script>
        window.WS_OVERVIEW_CONFIG = {
            year: @Model.Year,
            emptyState: @Html.Raw(emptyState != null ? $"\"{emptyState}\"" : "null"),
            isReadOnly: @Model.IsReadOnly.ToString().ToLower()
        };
    </script>
    <script src="~/js/work-schedule-overview.js" asp-append-version="true"></script>
}

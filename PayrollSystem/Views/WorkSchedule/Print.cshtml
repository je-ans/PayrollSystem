@model PayrollSystem.ViewModels.WorkSchedule.WorkScheduleViewModel
@{
    ViewData["Title"] = $"Schedule – {Model.MonthName} {Model.Year}";
    Layout = null;   // no navbar/sidebar on print page
    int counter = 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; font-size: 8pt; color: #000; background: #fff; }
        .no-print { margin-bottom: 10px; }
        @@media print { .no-print { display: none; } }

        .print-header { margin-bottom: 8px; }
        .print-header p { font-size: 9pt; font-weight: bold; }

        table { border-collapse: collapse; width: 100%; font-size: 7.5pt; }
        th, td { border: 1px solid #999; padding: 2px 3px; }

        .th-header { background: #1e3a5f; color: #fff; text-align: center; font-weight: bold; }
        .th-day { text-align: center; min-width: 30px; }
        .col-no { width: 22px; text-align: center; }
        .col-name { min-width: 110px; font-weight: 600; }
        .col-pos { min-width: 90px; font-size: 7pt; color: #444; }
        .col-sum { width: 36px; text-align: center; font-weight: bold; }

        .section-row td { background: #dbeafe; font-weight: bold; font-size: 8pt; padding: 3px 6px; }
        .emp-row td { vertical-align: middle; }
        .on-duty-row td { background: #fef9c3; font-weight: bold; text-align: center; font-size: 7pt; }

        .cell-val { text-align: center; font-weight: 600; white-space: nowrap; }
        .legend { margin-top: 8px; font-size: 7.5pt; }
        .legend strong { margin-right: 4px; }
        .legend span { margin-right: 10px; }

        .sig-block { margin-top: 30px; display: flex; justify-content: space-between; }
        .sig-line { border-top: 1px solid #000; width: 200px; text-align: center;
                    padding-top: 4px; font-size: 8pt; }
    </style>
</head>
<body>
    <div class="no-print" style="padding:10px">
        <button onclick="window.print()" style="padding:6px 16px;cursor:pointer">
            🖨️ Print / Save as PDF
        </button>
        <button onclick="window.close()" style="margin-left:8px;padding:6px 16px;cursor:pointer">
            Close
        </button>
    </div>

    <div class="print-header">
        <p>Organization Unit: @Model.OrganizationUnitDisplay</p>
        <p>Month: @Model.MonthName @Model.Year</p>
    </div>

    <table>
        <thead>
            <tr>
                <th class="th-header col-no">No</th>
                <th class="th-header col-name">Name</th>
                <th class="th-header col-pos">Position</th>
                @for (int d = 1; d <= Model.DaysInMonth; d++) {
                    <th class="th-header th-day">
                        @d<br /><span style="font-size:6.5pt">@Model.DayName(d)</span>
                    </th>
                }
                <th class="th-header col-sum">Days<br/>of Duty</th>
                <th class="th-header col-sum">Duty<br/>Hours</th>
                <th class="th-header col-sum">Leave/<br/>OFF</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sec in Model.Sections) {
                <tr class="section-row">
                    <td colspan="@(Model.DaysInMonth + 6)">@sec.Name</td>
                </tr>
                @foreach (var emp in sec.Employees) {
                    counter++;
                    var summary = Model.GetSummary(emp.Id);
                    <tr class="emp-row">
                        <td class="col-no" style="text-align:center">@counter</td>
                        <td class="col-name">@emp.FullName</td>
                        <td class="col-pos">@(emp.Designations.FirstOrDefault(d => d.EffectiveTo == null)?.Designation?.DesignationName ?? "-")</td>
                        @for (int d = 1; d <= Model.DaysInMonth; d++) {
                            var shift = Model.GetShift(emp.Id, d);
                            <td class="cell-val" style="color: @shift.ColorHex">
                                @shift.Code
                            </td>
                        }
                        <td class="col-sum" style="color:#16a34a">
                            @summary.DutyDays.ToString("F3").TrimEnd('0').TrimEnd('.')
                        </td>
                        <td class="col-sum" style="color:#2563eb">
                            @summary.DutyHours.ToString("F3").TrimEnd('0').TrimEnd('.')
                        </td>
                        <td class="col-sum" style="color:#dc2626">
                            @summary.LeaveOffCount
                        </td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr class="on-duty-row">
                <td colspan="3" style="text-align:left;padding-left:6px;font-weight:bold">On Duty</td>
                @for (int d = 1; d <= Model.DaysInMonth; d++) {
                    <td>@Model.GetOnDuty(d)</td>
                }
                <td colspan="3"></td>
            </tr>
        </tfoot>
    </table>

    <div class="legend">
        <strong>LEGEND:</strong>
        @foreach (var s in Model.ShiftTypes) {
            <span>@s.Code @(s != Model.ShiftTypes.Last() ? " |" : "")</span>
        }
    </div>

    <div class="sig-block">
        <div>
            <div class="sig-line">Prepared by</div>
        </div>
        <div>
            <div class="sig-line">Reviewed by</div>
        </div>
        <div>
            <div class="sig-line">Approved by</div>
        </div>
    </div>
</body>
</html>

@model AllowanceTypeViewModel

<div class="container-fluid">
    <div class="text-center my-3">
        <i class="fa fa-ban text-danger fa-3x"></i>
    </div>
    <h5 class="text-center mb-3">Cannot Delete Allowance Type</h5>
    <h5 class="font-weight-bold text-danger text-center">
        <strong>@Model.Name (@(Model.Code ?? "N/A"))</strong>
    </h5>
    <p class="text-muted text-center">This allowance type is currently assigned to one or more employee allowances. Please remove or reassign those allowances before deleting.</p>
</div>

@using PayrollSystem.Utility
@model IEnumerable<DutyExchangeRequestListViewModel>

@{
    var isEmployeePortal = ViewBag.IsEmployeePortal == true;
    ViewData["Title"] = isEmployeePortal ? "My Exchange of Duty Requests" : "Exchange of Duty";
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (!isEmployeePortal)
    {
        ViewBag.ActiveMenu = "AttendanceMonitoring";
        ViewBag.ActiveLink = "DutyExchangeRequest";
    }

    var filterStatus = ViewBag.FilterStatus as JustificationStatus?;
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var approvedCount = (int)(ViewBag.ApprovedCount ?? 0);
    var rejectedCount = (int)(ViewBag.RejectedCount ?? 0);
    var totalCount = (int)(ViewBag.TotalCount ?? Model?.Count() ?? 0);
    var hasItems = Model != null && Model.Any();
}

<link rel="stylesheet" href="~/css/approval-workflow.css" asp-append-version="true" />

<section class="content aw-page aw-queue-page">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-outline rounded-0 card-primary mx-2 px-2">
                    <div class="card-header d-flex align-items-center flex-wrap gap-2">
                        <div class="flex-grow-1">
                            <h3 class="card-title m-0">@(isEmployeePortal ? "My Exchange of Duty Requests" : "Exchange of Duty")</h3>
                            <p class="aw-intro mt-1 mb-0">
                                @if (isEmployeePortal)
                                {
                                    @:File a formal exchange of duty when swapping schedules with a colleague. Approved requests update monthly schedules automatically.
                                }
                                else
                                {
                                    @:Review exchange-of-duty requests between employees. Approved requests update monthly schedules.
                                }
                            </p>
                        </div>
                        @if (isEmployeePortal)
                        {
                            <a href="javascript:void(0)"
                               class="btn btn-sm btn-primary open-modal"
                               data-title="Exchange of Duty"
                               data-url="@Url.Action("Create", "DutyExchangeRequest")"
                               data-modal-type="create"
                               data-size="modal-lg">
                                <i class="fas fa-plus mr-1"></i> New request
                            </a>
                        }
                    </div>

                    <div class="card-body">
                        @if (!hasItems)
                        {
                            <div class="aw-empty-state">
                                <i class="fas fa-exchange-alt d-block"></i>
                                <h5>No exchange of duty requests</h5>
                                <p class="mb-0">
                                    @if (isEmployeePortal)
                                    {
                                        @:You have not filed any exchange of duty requests yet.
                                    }
                                    else
                                    {
                                        @:There are no exchange of duty requests yet.
                                    }
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="aw-pending-toolbar aw-pending-toolbar--row">
                                <div class="aw-pending-search">
                                    <i class="fas fa-search"></i>
                                    <input type="search"
                                           id="approvalQueueSearch"
                                           class="form-control form-control-sm"
                                           placeholder="Search employee, department, date, reason…"
                                           autocomplete="off" />
                                </div>
                                <div class="aw-pending-filters">
                                    @if (!isEmployeePortal)
                                    {
                                        <a asp-action="Index"
                                           asp-route-status="@((int?)JustificationStatus.Pending)"
                                           class="aw-filter-pill @(filterStatus == JustificationStatus.Pending ? "is-active" : "")">
                                            Pending <span class="aw-filter-count">@pendingCount</span>
                                        </a>
                                        <a asp-action="Index"
                                           asp-route-status="@((int?)JustificationStatus.Approved)"
                                           class="aw-filter-pill @(filterStatus == JustificationStatus.Approved ? "is-active" : "")">
                                            Approved <span class="aw-filter-count">@approvedCount</span>
                                        </a>
                                        <a asp-action="Index"
                                           asp-route-status="@((int?)JustificationStatus.Rejected)"
                                           class="aw-filter-pill @(filterStatus == JustificationStatus.Rejected ? "is-active" : "")">
                                            Rejected <span class="aw-filter-count">@rejectedCount</span>
                                        </a>
                                        <a asp-action="Index"
                                           asp-route-status=""
                                           class="aw-filter-pill @(!filterStatus.HasValue ? "is-active" : "")">
                                            All <span class="aw-filter-count">@totalCount</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="aw-filter-pill is-active">
                                            All <span class="aw-filter-count">@totalCount</span>
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover table-striped table-bordered aw-pending-table" id="approvalQueueTable" width="100%">
                                    <thead>
                                        <tr class="text-center">
                                            <th>No.</th>
                                            @if (!isEmployeePortal)
                                            {
                                                <th>Department</th>
                                            }
                                            <th>Date Filed</th>
                                            <th>Employee 1</th>
                                            <th>Original (Emp 1)</th>
                                            <th>Employee 2</th>
                                            <th>Original (Emp 2)</th>
                                            <th>Status</th>
                                            <th>Reason</th>
                                            <th>Submitted</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var index = 1;
                                            foreach (var item in Model!)
                                            {
                                                var statusBadge = item.Status switch
                                                {
                                                    JustificationStatus.Pending => "badge-warning",
                                                    JustificationStatus.Approved => "badge-success",
                                                    JustificationStatus.Rejected => "badge-danger",
                                                    _ => "badge-secondary"
                                                };
                                                var badgeText = item.Status switch
                                                {
                                                    JustificationStatus.Pending when item.CurrentStepOrder == 1 => "Pending (Step 1)",
                                                    JustificationStatus.Pending when item.CurrentStepOrder == 2 => "Pending (Step 2: HR)",
                                                    _ => EnumHelper.GetDisplayName(item.Status)
                                                };
                                                <tr data-queue-row>
                                                    <td class="text-center">@index</td>
                                                    @if (!isEmployeePortal)
                                                    {
                                                        <td>@(string.IsNullOrWhiteSpace(item.DepartmentName) ? "—" : item.DepartmentName)</td>
                                                    }
                                                    <td class="text-center">@item.DateFiled.ToString("MMM dd, yyyy")</td>
                                                    <td><span class="aw-queue-employee">@item.FirstEmployeeName</span></td>
                                                    <td class="text-center">
                                                        <div>@item.FirstOriginalDate.ToString("MMM dd, yyyy")</div>
                                                        <div class="small text-muted">@item.FirstOriginalShiftCode</div>
                                                    </td>
                                                    <td><span class="aw-queue-employee">@item.SecondEmployeeName</span></td>
                                                    <td class="text-center">
                                                        <div>@item.SecondOriginalDate.ToString("MMM dd, yyyy")</div>
                                                        <div class="small text-muted">@item.SecondOriginalShiftCode</div>
                                                    </td>
                                                    <td class="text-center"><span class="badge @statusBadge">@badgeText</span></td>
                                                    <td class="small text-left" title="@item.Reason">@item.Reason</td>
                                                    <td class="text-center">
                                                        <div class="small">@item.SubmittedBy</div>
                                                        <div class="aw-queue-meta">@item.SubmittedOn.ToString("MMM dd, yyyy hh:mm tt")</div>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (item.ApprovalRequestId.HasValue && item.Status == JustificationStatus.Pending && item.CanReview)
                                                        {
                                                            <div class="btn-group btn-group-sm aw-action-group mb-1">
                                                                <a href="javascript:void(0)"
                                                                   class="btn btn-success open-modal"
                                                                   data-title="Approve Exchange of Duty"
                                                                   data-url="@Url.Action("Process", "DutyExchangeRequest", new { id = item.Id, status = JustificationStatus.Approved })"
                                                                   data-modal-type="create"
                                                                   data-size="modal-lg">
                                                                    Approve
                                                                </a>
                                                                <a href="javascript:void(0)"
                                                                   class="btn btn-outline-danger open-modal"
                                                                   data-title="Reject Exchange of Duty"
                                                                   data-url="@Url.Action("Process", "DutyExchangeRequest", new { id = item.Id, status = JustificationStatus.Rejected })"
                                                                   data-modal-type="create"
                                                                   data-size="modal-lg">
                                                                    Reject
                                                                </a>
                                                            </div>
                                                        }
                                                        @if (item.Status == JustificationStatus.Approved)
                                                        {
                                                            <a href="@Url.Action("Print", "DutyExchangeRequest", new { id = item.Id })"
                                                               target="_blank"
                                                               class="btn btn-sm btn-outline-primary"
                                                               title="Print">
                                                                <i class="fas fa-print"></i>
                                                            </a>
                                                        }
                                                        else if (item.ApprovalRequestId.HasValue)
                                                        {
                                                            <a href="javascript:void(0)"
                                                               class="btn btn-sm btn-outline-secondary open-modal"
                                                               data-title="Exchange of Duty"
                                                               data-url="@Url.Action("Review", "DutyExchangeRequest", new { id = item.Id })"
                                                               data-modal-type="view"
                                                               data-size="modal-xl"
                                                               title="View">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                                index++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/approval-queue-list.js" asp-append-version="true"></script>
}

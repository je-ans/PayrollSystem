@model GovernmentContributionTableViewModel

<style>
    .section-header-container {
        position: relative;
    }

    .section-header {
        color: #2c3e50;
        font-weight: 600;
        position: relative;
        display: inline-block;
        padding-right: 1rem;
        background: white;
        z-index: 1;
    }

    .section-divider {
        position: absolute;
        top: 50%;
        width: 100%;
        height: 1px;
        background-color: #e0e0e0;
        z-index: 0;
    }

    .section-divider-wide {
        height: 1px;
        background: linear-gradient(to right, transparent, #e0e0e0, transparent);
    }
</style>

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-body">
            <span asp-validation-summary="All" class="text-danger"></span>
            <form asp-action="Edit" method="post" asp-antiforgery="true" id="editForm">
                <input type="hidden" asp-for="Id" />

                <!-- Basic Information Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Basic Information</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <select asp-for="GovernmentContributionTypeId" class="form-control floating-input select2 general-select"
                                asp-items="ViewBag.GovernmentContributionTypeId" required>
                            <option value="" selected disabled hidden>--Select Contribution Type--</option>
                        </select>
                        <label asp-for="GovernmentContributionTypeId" class="floating-label">Contribution Type <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="GovernmentContributionTypeId" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="EffectiveStartDate" type="date" class="form-control floating-input" required placeholder=" ">
                        <label asp-for="EffectiveStartDate" class="floating-label">Effective Start Date <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="EffectiveStartDate" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="EffectiveEndDate" type="date" class="form-control floating-input" placeholder=" ">
                        <label asp-for="EffectiveEndDate" class="floating-label">Effective End Date</label>
                    </div>
                    <span asp-validation-for="EffectiveEndDate" class="text-danger small validation-message"></span>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Salary Range Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Salary Range</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="MinSalary" type="number" step="0.01" class="form-control floating-input" required placeholder=" ">
                        <label asp-for="MinSalary" class="floating-label">Minimum Salary <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="MinSalary" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="MaxSalary" type="number" step="0.01" class="form-control floating-input" placeholder=" ">
                        <label asp-for="MaxSalary" class="floating-label">Maximum Salary</label>
                    </div>
                    <span asp-validation-for="MaxSalary" class="text-danger small validation-message"></span>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Fixed Contributions Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Fixed Contributions</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="EmployeeShare" type="number" step="0.01" class="form-control floating-input" placeholder=" ">
                        <label asp-for="EmployeeShare" class="floating-label">Employee Share (Fixed)</label>
                    </div>
                    <span asp-validation-for="EmployeeShare" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="EmployerShare" type="number" step="0.01" class="form-control floating-input" placeholder=" ">
                        <label asp-for="EmployerShare" class="floating-label">Employer Share (Fixed)</label>
                    </div>
                    <span asp-validation-for="EmployerShare" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="TotalContribution" type="number" step="0.01" class="form-control floating-input" placeholder=" ">
                        <label asp-for="TotalContribution" class="floating-label">Total Contribution (Fixed)</label>
                    </div>
                    <span asp-validation-for="TotalContribution" class="text-danger small validation-message"></span>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Percentage Contributions Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Percentage Contributions</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="EmployeeSharePercentage" type="number" step="0.01" class="form-control floating-input" placeholder=" ">
                        <label asp-for="EmployeeSharePercentage" class="floating-label">Employee Share (%)</label>
                    </div>
                    <span asp-validation-for="EmployeeSharePercentage" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="EmployerSharePercentage" type="number" step="0.01" class="form-control floating-input" placeholder=" ">
                        <label asp-for="EmployerSharePercentage" class="floating-label">Employer Share (%)</label>
                    </div>
                    <span asp-validation-for="EmployerSharePercentage" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="MaxEmployeeContribution" type="number" step="0.01" class="form-control floating-input" placeholder=" ">
                        <label asp-for="MaxEmployeeContribution" class="floating-label">Maximum Employee Contribution</label>
                    </div>
                    <span asp-validation-for="MaxEmployeeContribution" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="MaxEmployerContribution" type="number" step="0.01" class="form-control floating-input" placeholder=" ">
                        <label asp-for="MaxEmployerContribution" class="floating-label">Maximum Employer Contribution</label>
                    </div>
                    <span asp-validation-for="MaxEmployerContribution" class="text-danger small validation-message"></span>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Settings Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Settings</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="custom-control custom-switch">
                        <input asp-for="IsActive" type="checkbox" class="custom-control-input" id="isActiveSwitch">
                        <label class="custom-control-label" for="isActiveSwitch">Is Active</label>
                    </div>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Additional Notes Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Additional Notes</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <textarea asp-for="Notes" class="form-control floating-input" rows="3" placeholder=" "></textarea>
                        <label asp-for="Notes" class="floating-label">Notes</label>
                    </div>
                    <span asp-validation-for="Notes" class="text-danger small validation-message"></span>
                </div>

            </form>
        </div>
    </div>
</div>

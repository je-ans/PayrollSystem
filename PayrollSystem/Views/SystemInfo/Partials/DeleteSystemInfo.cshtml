@model SystemInfoViewModel

<div class="container-fluid">
    <span asp-validation-summary="All" class="text-danger"></span>
    <form asp-action="DeleteConfirmed" method="post" asp-antiforgery="true" id="deleteForm">
        <input type="hidden" asp-for="Id" />

        <div class="text-center my-3">
            <i class="fa fa-exclamation-triangle text-danger fa-3x"></i>
        </div>
        <h5 class="text-center mb-3">Are you sure you want to delete the system information?</h5>
        <h5 class="font-weight-bold text-danger text-center">
            <strong>@Model.ShortName - @Model.SystemName</strong>
        </h5>
        <p class="text-muted text-center">This action cannot be undone.</p>
    </form>
</div>
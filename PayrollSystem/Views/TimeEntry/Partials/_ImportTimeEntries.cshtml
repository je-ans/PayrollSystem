@model List<TimeEntry>

<div class="container-fluid">
    <span asp-validation-summary="All" class="text-danger"></span>
    <form asp-action="ImportTimeEntries" method="post" asp-antiforgery="true" id="timeEntriesImportForm">
        <div class="form-group">
            <div class="alert alert-info">
                <h6><i class="fas fa-info-circle"></i> Time Entries Import Instructions</h6>
                <ul class="mb-0">
                    <li>Use this form to import pre-formatted time entry data</li>
                    <li>Data should be in JSON format or structured format</li>
                    <li>Each entry must include EmployeeId, EntryType, EntryDateTime</li>
                    <li>Optional fields: BiometricDeviceId, Location, Notes</li>
                </ul>
            </div>
        </div>

        <div class="form-group">
            <div class="input-container">
                <textarea name="timeEntriesJson" class="form-control floating-input" rows="15" placeholder=" " required></textarea>
                <label class="floating-label">Time Entries Data (JSON)</label>
            </div>
            <small class="form-text text-muted">Paste JSON array of time entries</small>
        </div>

        <div class="form-group">
            <button type="button" class="btn btn-secondary" onclick="loadSampleData()">Load Sample Data</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function loadSampleData() {
            var sampleData = [
                {
                    "employeeId": "",
                    "entryType": 0,
                    "entryDateTime": "2025-01-25T08:00:00",
                    "biometricDeviceId": "SampleDevice",
                    "location": "Main Office",
                    "notes": "Sample entry"
                }
            ];

            $('textarea[name="timeEntriesJson"]').val(JSON.stringify(sampleData, null, 2));
        }
    </script>
}
@model TimeEntry

<div class="alert alert-danger">
    <h5><i class="icon fas fa-ban"></i> Delete Time Entry</h5>
    Are you sure you want to delete this time entry?
    <br><br>
    <strong>Employee:</strong> @Model.Employee.FirstName @Model.Employee.Surname<br>
    <strong>Entry Type:</strong> @Model.EntryType<br>
    <strong>Date & Time:</strong> @Model.EntryDateTime.ToString("MMM dd, yyyy hh:mm:ss tt")<br>
    <strong>Source:</strong> @(Model.IsManualEntry ? "Manual" : "Biometric")
    <br><br>
    This action cannot be undone.
</div>

<form id="deleteTimeEntryForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
</form>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-danger" onclick="submitDeleteTimeEntry()">Delete</button>
</div>

@section Scripts {
    <script>
        function submitDeleteTimeEntry() {
            var formData = $('#deleteTimeEntryForm').serialize();

            $.ajax({
                url: '/TimeEntry/DeleteTimeEntryConfirmed',
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        $('#timeEntryModal').modal('hide');
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while deleting the time entry.');
                }
            });
        }
    </script>
}
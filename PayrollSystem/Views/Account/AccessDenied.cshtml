@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="text-center" style="max-width: 640px;">
        <div class="mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="text-danger">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0V10.5m-.75 0h10.5A1.5 1.5 0 0118.75 12v7.5a1.5 1.5 0 01-1.5 1.5H6.75a1.5 1.5 0 01-1.5-1.5V12a1.5 1.5 0 011.5-1.5z" />
            </svg>
        </div>
        <h1 class="display-6 text-danger mb-2">Access Denied</h1>
        <p class="lead text-muted mb-4">You don't have permission to view this page.</p>

        <div class="card shadow-sm mb-2">
            <div class="card-body">
                <p class="mb-0 text-secondary">
                    If you believe this is a mistake, please contact your system administrator to request access, or try a different page.
                </p>
            </div>
        </div>

        <div class="">
            <small class="text-muted">Error code: 403 • Access is restricted based on your assigned permissions.</small>
        </div>

        <div class="d-flex flex-wrap justify-content-center mt-3">
            <a class="btn btn-primary mx-1 my-1" href="@Url.Action("Index", "Home")">Go to Dashboard</a>
            @* <button type="button" class="btn btn-outline-secondary mx-1 my-1" onclick="history.back()">Go Back</button> *@
            <a class="btn btn-outline-danger mx-1 my-1" href="@Url.Action("Logout", "Account")">Sign out</a>
        </div>

    </div>
    
</div>


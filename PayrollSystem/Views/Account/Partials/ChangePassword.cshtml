@model UserProfileAndChangePasswordViewModel

<form id="passwordForm" method="post" asp-action="UpdatingUserProfile">
    <input type="hidden" name="FormType" value="Password" />
    <div class="form-group">
        <div class="input-container">
            <input asp-for="ChangePassword.CurrentPassword" type="password" class="form-control floating-input" required placeholder=" ">
            <label asp-for="ChangePassword.CurrentPassword" class="floating-label">Current Password</label>
        </div>
        <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger validation-message"></span>
    </div>
    <div class="form-group">
        <div class="input-container">
            <input asp-for="ChangePassword.NewPassword" type="password" class="form-control floating-input" required placeholder=" ">
            <label asp-for="ChangePassword.NewPassword" class="floating-label">New Password</label>
        </div>
        <span asp-validation-for="ChangePassword.NewPassword" class="text-danger validation-message"></span>
    </div>
    <div class="form-group">
        <div class="input-container">
            <input asp-for="ChangePassword.ConfirmNewPassword" type="password" class="form-control floating-input" required placeholder=" ">
            <label asp-for="ChangePassword.ConfirmNewPassword" class="floating-label">Confirm New Password</label>
        </div>
        <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger validation-message"></span>
    </div>


    <button type="submit" class="btn btn-primary submitButton" id="">Change Password</button>
</form>
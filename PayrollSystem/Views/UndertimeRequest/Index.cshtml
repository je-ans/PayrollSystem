@using PayrollSystem.Utility
@model IEnumerable<UndertimeRequestListViewModel>

@{
    var isEmployeePortal = ViewBag.IsEmployeePortal == true;
    ViewData["Title"] = isEmployeePortal ? "My Undertime Requests" : "Undertime Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
    if (!isEmployeePortal)
    {
        ViewBag.ActiveMenu = "AttendanceMonitoring";
        ViewBag.ActiveLink = "UndertimeRequest";
    }

    var filterStatus = ViewBag.FilterStatus as JustificationStatus?;
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var approvedCount = (int)(ViewBag.ApprovedCount ?? 0);
    var rejectedCount = (int)(ViewBag.RejectedCount ?? 0);
    var totalCount = (int)(ViewBag.TotalCount ?? Model?.Count() ?? 0);
    var hasItems = Model != null && Model.Any();
}

<link rel="stylesheet" href="~/css/approval-workflow.css" asp-append-version="true" />

<section class="content aw-page aw-queue-page">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-outline rounded-0 card-primary mx-2 px-2">
                    <div class="card-header d-flex align-items-center flex-wrap gap-2">
                        <div class="flex-grow-1">
                            <h3 class="card-title m-0">@(isEmployeePortal ? "My Undertime Requests" : "Undertime Requests")</h3>
                            <p class="aw-intro mt-1 mb-0">
                                @if (isEmployeePortal)
                                {
                                    @:File a formal undertime request when you leave early. Approved forms document authorization — DTR computed undertime is unchanged.
                                }
                                else
                                {
                                    @:Review undertime authorization requests. Approval does not modify DTR or payroll calculations.
                                }
                            </p>
                        </div>
                        @if (isEmployeePortal)
                        {
                            <a href="javascript:void(0)"
                               class="btn btn-sm btn-primary open-modal"
                               data-title="Undertime Request"
                               data-url="@Url.Action("Create", "UndertimeRequest")"
                               data-modal-type="create"
                               data-size="modal-lg">
                                <i class="fas fa-plus mr-1"></i> New request
                            </a>
                        }
                    </div>

                    <div class="card-body">
                        @if (!hasItems)
                        {
                            <div class="aw-empty-state">
                                <i class="fas fa-file-signature d-block"></i>
                                <h5>No undertime requests</h5>
                                <p class="mb-0">
                                    @(isEmployeePortal
                                        ? "You have not filed any undertime requests yet."
                                        : "There are no undertime requests yet.")
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="aw-pending-toolbar aw-pending-toolbar--row">
                                <div class="aw-pending-search">
                                    <i class="fas fa-search"></i>
                                    <input type="search" id="approvalQueueSearch" class="form-control form-control-sm"
                                           placeholder="Search employee, ID, date, purpose…" autocomplete="off" />
                                </div>
                                <div class="aw-pending-filters">
                                    @if (!isEmployeePortal)
                                    {
                                        <a asp-action="Index" asp-route-status="@((int?)JustificationStatus.Pending)"
                                           class="aw-filter-pill @(filterStatus == JustificationStatus.Pending ? "is-active" : "")">
                                            Pending <span class="aw-filter-count">@pendingCount</span>
                                        </a>
                                        <a asp-action="Index" asp-route-status="@((int?)JustificationStatus.Approved)"
                                           class="aw-filter-pill @(filterStatus == JustificationStatus.Approved ? "is-active" : "")">
                                            Approved <span class="aw-filter-count">@approvedCount</span>
                                        </a>
                                        <a asp-action="Index" asp-route-status="@((int?)JustificationStatus.Rejected)"
                                           class="aw-filter-pill @(filterStatus == JustificationStatus.Rejected ? "is-active" : "")">
                                            Rejected <span class="aw-filter-count">@rejectedCount</span>
                                        </a>
                                        <a asp-action="Index" asp-route-status=""
                                           class="aw-filter-pill @(!filterStatus.HasValue ? "is-active" : "")">
                                            All <span class="aw-filter-count">@totalCount</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="aw-filter-pill is-active">All <span class="aw-filter-count">@totalCount</span></span>
                                    }
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover table-striped table-bordered aw-pending-table" id="approvalQueueTable" width="100%">
                                    <thead>
                                        <tr class="text-center">
                                            <th>No.</th>
                                            @if (!isEmployeePortal)
                                            {
                                                <th>Employee</th>
                                                <th>ID No.</th>
                                            }
                                            <th>Date Filed</th>
                                            <th>Date of Undertime</th>
                                            <th>Duration</th>
                                            <th>Status</th>
                                            <th>Purpose</th>
                                            <th>Submitted</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var index = 1;
                                            foreach (var item in Model!)
                                            {
                                                var statusBadge = item.Status switch
                                                {
                                                    JustificationStatus.Pending => "badge-warning",
                                                    JustificationStatus.Approved => "badge-success",
                                                    JustificationStatus.Rejected => "badge-danger",
                                                    _ => "badge-secondary"
                                                };
                                                var badgeText = item.Status switch
                                                {
                                                    JustificationStatus.Pending when item.CurrentStepOrder == 1 => "Pending (Step 1)",
                                                    JustificationStatus.Pending when item.CurrentStepOrder == 2 => "Pending (Step 2: HR)",
                                                    _ => EnumHelper.GetDisplayName(item.Status)
                                                };
                                                <tr data-queue-row>
                                                    <td class="text-center">@index</td>
                                                    @if (!isEmployeePortal)
                                                    {
                                                        <td><span class="aw-queue-employee">@item.EmployeeName</span></td>
                                                        <td class="text-center">@item.EmployeeIdNumber</td>
                                                    }
                                                    <td class="text-center">@item.DateFiled.ToString("MMM dd, yyyy")</td>
                                                    <td class="text-center">
                                                        @item.DateOfUndertime.ToString("MMM dd, yyyy")
                                                        @if (item.IsHistoricalDate)
                                                        {
                                                            <div class="small text-muted">Historical</div>
                                                        }
                                                    </td>
                                                    <td class="text-center">@item.DurationHours.ToString("0.##") h</td>
                                                    <td class="text-center"><span class="badge @statusBadge">@badgeText</span></td>
                                                    <td class="small text-left" title="@item.Purpose">@item.Purpose</td>
                                                    <td class="text-center">
                                                        <div class="small">@item.SubmittedBy</div>
                                                        <div class="aw-queue-meta">@item.SubmittedOn.ToString("MMM dd, yyyy hh:mm tt")</div>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (item.ApprovalRequestId.HasValue && item.Status == JustificationStatus.Pending && item.CanReview)
                                                        {
                                                            <div class="btn-group btn-group-sm aw-action-group mb-1">
                                                                <a href="javascript:void(0)" class="btn btn-success open-modal"
                                                                   data-title="Approve Undertime"
                                                                   data-url="@Url.Action("Process", "UndertimeRequest", new { id = item.Id, status = JustificationStatus.Approved })"
                                                                   data-modal-type="create" data-size="modal-lg">Approve</a>
                                                                <a href="javascript:void(0)" class="btn btn-outline-danger open-modal"
                                                                   data-title="Reject Undertime"
                                                                   data-url="@Url.Action("Process", "UndertimeRequest", new { id = item.Id, status = JustificationStatus.Rejected })"
                                                                   data-modal-type="create" data-size="modal-lg">Reject</a>
                                                            </div>
                                                        }
                                                        @if (item.Status == JustificationStatus.Approved)
                                                        {
                                                            <a href="@Url.Action("Print", "UndertimeRequest", new { id = item.Id })" target="_blank"
                                                               class="btn btn-sm btn-outline-primary" title="Print"><i class="fas fa-print"></i></a>
                                                        }
                                                        else if (item.ApprovalRequestId.HasValue)
                                                        {
                                                            <a href="javascript:void(0)" class="btn btn-sm btn-outline-secondary open-modal"
                                                               data-title="Undertime Request"
                                                               data-url="@Url.Action("Review", "UndertimeRequest", new { id = item.Id })"
                                                               data-modal-type="view" data-size="modal-xl" title="View"><i class="fas fa-eye"></i></a>
                                                        }
                                                    </td>
                                                </tr>
                                                index++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/approval-queue-list.js" asp-append-version="true"></script>
}

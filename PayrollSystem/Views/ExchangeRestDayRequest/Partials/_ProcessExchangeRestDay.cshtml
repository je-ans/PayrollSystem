@using PayrollSystem.Utility
@model ExchangeRestDayProcessViewModel

<link rel="stylesheet" href="~/css/dtr-modals.css" asp-append-version="true" />

<form id="exchangeRestDayProcessForm" method="post" asp-action="Process" asp-controller="ExchangeRestDayRequest">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ReviewAction" />

    <div class="dm-modal">
        <div class="dm-process-header">
            <div>
                <h6>@EnumHelper.GetDisplayName(Model.ReviewAction) exchange rest day</h6>
                <small>@Model.FirstEmployeeName ↔ @Model.SecondEmployeeName</small>
            </div>
            <span class="dm-status @(Model.ReviewAction == JustificationStatus.Approved ? "dm-status--approved" : "dm-status--rejected")">
                @Model.ReviewAction
            </span>
        </div>

        <div class="dm-section">
            <div class="dm-section-header">
                <i class="fas fa-calendar-day"></i>
                Exchange summary
            </div>
            <div class="dm-section-body">
                <div class="dm-detail-grid dm-detail-grid--compact mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.DepartmentName))
                    {
                        <div class="dm-detail-item dm-detail-item--full">
                            <span class="dm-detail-label">Department</span>
                            <span class="dm-detail-value">@Model.DepartmentName</span>
                        </div>
                    }
                    <div class="dm-detail-item">
                        <span class="dm-detail-label">Date filed</span>
                        <span class="dm-detail-value">@Model.DateFiled.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="dm-detail-item dm-detail-item--full mb-3">
                            <span class="dm-detail-label">First employee</span>
                            <span class="dm-detail-value">@Model.FirstEmployeeName</span>
                            <div class="small text-muted">@Model.FirstEmployeeIdNumber</div>
                        </div>
                        <div class="small mb-1"><strong>Rest day:</strong> @Model.FirstRestDate.ToString("MMM dd, yyyy") · @Model.FirstRestShiftDisplay</div>
                        <div class="small"><strong>Works on colleague rest day:</strong> @Model.SecondRestDate.ToString("MMM dd, yyyy") · @Model.FirstWorkShiftDisplay</div>
                    </div>
                    <div class="col-md-6">
                        <div class="dm-detail-item dm-detail-item--full mb-3">
                            <span class="dm-detail-label">Second employee</span>
                            <span class="dm-detail-value">@Model.SecondEmployeeName</span>
                            <div class="small text-muted">@Model.SecondEmployeeIdNumber</div>
                        </div>
                        <div class="small mb-1"><strong>Rest day:</strong> @Model.SecondRestDate.ToString("MMM dd, yyyy") · @Model.SecondRestShiftDisplay</div>
                        <div class="small"><strong>Works on first rest day:</strong> @Model.FirstRestDate.ToString("MMM dd, yyyy") · @Model.SecondWorkShiftDisplay</div>
                    </div>
                </div>

                <div class="mt-3">
                    <span class="dm-detail-label d-block mb-1">Reason</span>
                    <p class="dm-reason-box mb-0">@Model.Reason</p>
                </div>

                @if (Model.ReviewAction == JustificationStatus.Approved)
                {
                    <div class="dm-alert-banner dm-alert-banner--info mt-3 mb-0">
                        <i class="fas fa-info-circle"></i>
                        <div>Approving will swap both employees' rest/work days when this is the final approval step.</div>
                    </div>
                }
            </div>
        </div>

        <div class="dm-section">
            <div class="dm-section-header">
                <i class="fas fa-sticky-note"></i>
                Reviewer notes
            </div>
            <div class="dm-section-body">
                @if (Model.ReviewAction == JustificationStatus.Rejected)
                {
                    <div class="dm-alert-banner dm-alert-banner--warning mb-3">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>Please provide a reason when rejecting this request.</div>
                    </div>
                    <label asp-for="ReviewNotes" class="dm-form-label">Rejection notes</label>
                    <textarea asp-for="ReviewNotes" class="form-control dm-form-control" rows="3" required
                              placeholder="Enter reason for rejection…"></textarea>
                    <span asp-validation-for="ReviewNotes" class="text-danger validation-message"></span>
                }
                else
                {
                    <label asp-for="ReviewNotes" class="dm-form-label">Notes (optional)</label>
                    <textarea asp-for="ReviewNotes" class="form-control dm-form-control" rows="2"
                              placeholder="Optional internal notes…"></textarea>
                }
            </div>
        </div>
    </div>
</form>

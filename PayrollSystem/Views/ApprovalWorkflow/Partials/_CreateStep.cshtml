@model ApprovalWorkflowStepViewModel

<div class="container-fluid">
    <p class="text-muted small">Workflow: <strong>@Model.WorkflowName</strong></p>
    <form asp-action="CreateStep" method="post" asp-antiforgery="true" id="stepForm">
        <input type="hidden" asp-for="WorkflowId" />
        <div class="form-group">
            <div class="input-container">
                <input asp-for="StepOrder" type="number" min="1" class="form-control floating-input" required placeholder=" " />
                <label asp-for="StepOrder" class="floating-label">Step Order <span class="text-danger">*</span></label>
            </div>
        </div>
        <div class="form-group">
            <div class="input-container">
                <input asp-for="Name" class="form-control floating-input" required placeholder=" " />
                <label asp-for="Name" class="floating-label">Step Name <span class="text-danger">*</span></label>
            </div>
        </div>
    </form>
</div>

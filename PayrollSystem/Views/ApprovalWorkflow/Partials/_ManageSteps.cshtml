@model List<PayrollSystem.Models.Workflow.ApprovalWorkflowStep>

<div class="container-fluid">
    <p class="text-muted small mb-2">
        <strong>@ViewBag.WorkflowName</strong> — @ViewBag.ProcessTypeDisplay
    </p>
    <div class="d-flex justify-content-end mb-2" asp-permission="APPROVAL_WORKFLOW_VIEW">
        <a href="javascript:void(0)" class="btn btn-sm btn-primary open-modal"
           data-title="Add Step"
           data-url="@Url.Action("CreateStep", new { workflowId = ViewBag.WorkflowId })"
           data-modal-type="create">
            <i class="fas fa-plus"></i> Add Step
        </a>
    </div>
    @if (Model.Count == 0)
    {
        <p class="text-muted">No steps configured yet.</p>
    }
    else
    {
        <table class="table table-sm table-bordered">
            <thead class="thead-light">
                <tr>
                    <th class="text-center" style="width:60px">Order</th>
                    <th>Step Name</th>
                    <th class="text-center" style="width:100px">Approvers</th>
                    <th class="text-center" style="width:120px">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var step in Model.OrderBy(s => s.StepOrder))
                {
                    <tr>
                        <td class="text-center">@step.StepOrder</td>
                        <td>@step.Name</td>
                        <td class="text-center">@step.Approvers.Count</td>
                        <td class="text-center">
                            <a href="javascript:void(0)" class="btn btn-xs btn-info open-modal mr-1"
                               data-title="Approvers — @step.Name"
                               data-url="@Url.Action("Approvers", new { stepId = step.Id })"
                               data-modal-type="view"
                               data-modal-size="lg">
                                Approvers
                            </a>
                            <a href="javascript:void(0)" class="btn btn-xs btn-default open-modal"
                               data-title="Edit Step"
                               data-url="@Url.Action("EditStep", new { id = step.Id })"
                               data-modal-type="edit">
                                Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

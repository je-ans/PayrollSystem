@model HolidayFormViewModel

<form asp-action="DeleteConfirmed" method="post" asp-antiforgery="true" id="deleteHolidayForm">
    <input type="hidden" asp-for="Id" />
    <div class="text-center my-3">
        <i class="fa fa-exclamation-triangle text-danger fa-3x"></i>
    </div>
    <h5 class="text-center mb-3">Are you sure you want to delete this holiday?</h5>
    <h5 class="font-weight-bold text-danger text-center">
        <strong>@Model.Name</strong>
    </h5>
    <p class="text-muted text-center mb-0">
        @Model.Date.ToString("MMM d, yyyy")
        @if (Model.IsRecurring)
        {
            <span>· recurring</span>
        }
    </p>
    <p class="text-muted text-center">The working calendar will be refreshed for affected dates.</p>
</form>

@model AssignEmployeesAndTimeCardViewModel

@{
    ViewData["Title"] = "Employee Time Card";
    ViewBag.ActiveMenu = "PayrollPeriod";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/payroll-time-card.css" asp-append-version="true" />

<section class="content ptc-page">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-outline rounded-0 card-primary mx-2 px-2">

                    <div class="card-header d-flex align-items-center flex-wrap gap-2">
                        <div class="flex-grow-1">
                            <h3 class="card-title m-0">Employee Time Card</h3>
                            <p class="ptc-intro mt-1 mb-0">@Model.PayrollPeriodName — @Model.PeriodRange</p>
                        </div>
                        <div class="card-tools d-flex align-items-center flex-wrap gap-1">
                            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "PayrollPeriod")">
                                <i class="fas fa-arrow-left mr-1"></i> Back
                            </a>
                            @if (Model.TotalEmployees > 0)
                            {
                                <a href="javascript:void(0)" class="btn btn-outline-info btn-sm open-modal"
                                   data-title="All Employees — @Model.PayrollPeriodName"
                                   data-url="@Url.Action("ViewAllEmployees", "PayrollPeriod", new { id = Model.PayrollPeriodId })"
                                   data-modal-type="view"
                                   data-size="modal-xl">
                                    <i class="fas fa-users mr-1"></i> View Employees
                                    <span class="badge badge-light ml-1">@Model.TotalEmployees</span>
                                </a>
                            }
                            @if (!Model.IsLocked && !Model.HasCompletedPayrollRun)
                            {
                                <a href="javascript:void(0)" class="btn btn-primary btn-sm open-modal"
                                   data-title="Add Employee Group"
                                   data-url="@Url.Action("EditBatch", "PayrollPeriod", new { id = Model.PayrollPeriodId })"
                                   data-modal-type="edit"
                                   data-size="modal-xl">
                                    <i class="fas fa-plus mr-1"></i> Add Employee Group
                                </a>
                            }
                            else if (Model.HasCompletedPayrollRun)
                            {
                                <span class="btn btn-secondary btn-sm disabled" title="Payroll has already been run for this period.">
                                    <i class="fas fa-check-circle mr-1"></i> Payroll Run Completed
                                </span>
                            }
                            else
                            {
                                <span class="btn btn-secondary btn-sm disabled" title="Payroll period is locked.">
                                    <i class="fas fa-lock mr-1"></i> Locked
                                </span>
                            }
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="ptc-period-banner mb-3">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div>
                                    <p class="ptc-period-title mb-0">
                                        <i class="fas fa-calendar-check mr-1 text-primary"></i>
                                        @Model.PayrollPeriodName
                                    </p>
                                    <div class="ptc-period-range">@Model.PeriodRange</div>
                                </div>
                                <div class="ptc-period-badges">
                                    @if (Model.IsLocked)
                                    {
                                        <span class="badge badge-warning px-2 py-1"><i class="fas fa-lock mr-1"></i> Locked</span>
                                    }
                                    @if (Model.HasCompletedPayrollRun)
                                    {
                                        <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i> Run Completed</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (Model.IsLocked)
                        {
                            <div class="alert alert-warning py-2 mb-3 border-0" style="border-radius:10px;">
                                <i class="fas fa-lock mr-1"></i>
                                This payroll period is <strong>locked</strong>. No changes can be made.
                            </div>
                        }
                        @if (Model.HasCompletedPayrollRun)
                        {
                            <div class="alert alert-success py-2 mb-3 border-0" style="border-radius:10px;">
                                <i class="fas fa-check-circle mr-1"></i>
                                A <strong>completed payroll run</strong> exists for this period.
                                Employee groups cannot be added, edited, or deleted.
                            </div>
                        }

                        @if (!Model.IsLocked && !Model.HasCompletedPayrollRun)
                        {
                            <div class="ptc-tip-strip mb-3">
                                <i class="fas fa-route"></i>
                                <div>
                                    <strong>Workflow:</strong> Add employee groups by department or type → DTR data imports automatically →
                                    use <strong>Edit Group</strong> to adjust hours before payroll run.
                                </div>
                            </div>
                        }

                        <div class="ptc-summary-grid">
                            <div class="ptc-stat-card ptc-stat-groups">
                                <div class="ptc-stat-value">@(Model.Batches?.Count ?? 0)</div>
                                <div class="ptc-stat-label">Employee Groups</div>
                            </div>
                            <div class="ptc-stat-card ptc-stat-employees">
                                <div class="ptc-stat-value">@Model.TotalEmployees</div>
                                <div class="ptc-stat-label">Total Employees</div>
                            </div>
                        </div>

                        <div class="ptc-section-header">
                            <i class="fas fa-layer-group"></i>
                            Employee Groups
                        </div>

                        <div class="ptc-table-panel">
                            <table class="table table-hover table-striped table-bordered mb-0"
                                   id="batchesTable" width="100%">
                                <thead>
                                    <tr class="text-center">
                                        <th style="width:60px;">No.</th>
                                        <th>Department</th>
                                        <th>Employment Type</th>
                                        <th style="width:120px;">Employees</th>
                                        <th style="width:160px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        $(document).ready(function () {

            var batches = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (Model.Batches ?? new List<PayrollPeriodBatchSummaryRowViewModel>())
            .Select(b => new
            {
           batchId = b.BatchId,
           organizationUnitName = b.OrganizationUnitName,
           employmentTypeName = b.EmploymentTypeName,
           employeeCount = b.EmployeeCount,
           displayOrder = b.DisplayOrder
            })
        ));

            var isLocked        = @(Model.IsLocked ? "true" : "false");
            var hasCompletedRun = @(Model.HasCompletedPayrollRun ? "true" : "false");
            var periodId        = @Model.PayrollPeriodId;

            $('#batchesTable').DataTable({
                data: batches,
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) { return meta.row + 1; },
                        className: 'text-center',
                        orderable: false
                    },
                    { data: 'organizationUnitName' },
                    { data: 'employmentTypeName' },
                    { data: 'employeeCount', className: 'text-center' },
                    {
                        data: null,
                        orderable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            if (isLocked || hasCompletedRun) {
                                return '<span class="text-muted">—</span>';
                            }
                            return '<button type="button" class="btn btn-flat p-1 btn-default btn-sm dropdown-toggle dropdown-icon" data-toggle="dropdown">Action</button>'
                                 + '<div class="dropdown-menu dropdown-menu-right" role="menu">'
                                 + '<a href="javascript:void(0)" class="dropdown-item open-modal"'
                                 + ' data-title="Edit Employee Group"'
                                 + ' data-url="/PayrollPeriod/EditBatch?id=' + periodId + '&batchId=' + row.batchId + '"'
                                 + ' data-modal-type="edit" data-size="modal-xl">'
                                 + '<i class="fa fa-edit mr-2 text-primary"></i><span>Edit Group</span></a>'
                                 + '<div class="dropdown-divider"></div>'
                                 + '<a href="javascript:void(0)" class="dropdown-item btn-delete-batch"'
                                 + ' data-batch-id="' + row.batchId + '" data-period-id="' + periodId + '">'
                                 + '<i class="fa fa-trash mr-2 text-danger"></i><span>Delete Group</span></a>'
                                 + '</div>';
                        }
                    }
                ],
                responsive: true,
                lengthChange: true,
                autoWidth: false,
                language: {
                    emptyTable: '<div class="ptc-empty-state"><i class="fas fa-layer-group d-block"></i>No employee groups yet.<br/>Click <strong>Add Employee Group</strong> to get started.</div>'
                }
            });

            $(document).on('click', '.btn-delete-batch', function () {
                var batchId = $(this).data('batch-id');
                var token   = $('input[name="__RequestVerificationToken"]').val();

                Swal.fire({
                    title: 'Delete Employee Group',
                    html: 'Delete this employee group? Employees will be removed from the period unless they belong to another group.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    Swal.fire({ title: 'Deleting...', allowOutsideClick: false, showConfirmButton: false, didOpen: function () { Swal.showLoading(); } });

                    $.ajax({
                        url: '@Url.Action("DeleteBatch", "PayrollPeriod")',
                        type: 'POST',
                        data: { __RequestVerificationToken: token, batchId: batchId },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({ icon: 'success', title: 'Deleted', text: response.message, timer: 2000, showConfirmButton: false })
                                    .then(function () { window.location.reload(); });
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: response.message });
                            }
                        },
                        error: function () {
                            Swal.fire({ icon: 'error', title: 'Error', text: 'Delete failed. Please try again.' });
                        }
                    });
                });
            });
        });
    </script>
}

@model DesignationViewModel

<div class="container-fluid">
    <span asp-validation-summary="All" class="text-danger"></span>
    <form asp-action="CreateDesignation" method="post" asp-antiforgery="true" id="designationForm">
        <div class="form-group">
            <div class="input-container">
                <input asp-for="DesignationName" type="text" class="form-control floating-input" required placeholder=" ">
                <label asp-for="DesignationName" class="floating-label">Designation</label>
            </div>
            <span asp-validation-for="DesignationName" class="text-danger validation-message"></span>
        </div>

        <div class="form-group">
            <div class="input-container">
                <input asp-for="DesignationDescription" type="text" class="form-control floating-input" required placeholder=" ">
                <label asp-for="DesignationDescription" class="floating-label">Description</label>
            </div>
            <span asp-validation-for="DesignationDescription" class="text-danger validation-message"></span>
        </div>
    </form>
</div>


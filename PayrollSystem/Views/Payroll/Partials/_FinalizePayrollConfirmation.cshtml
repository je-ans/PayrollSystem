@model PayrollRun

<div class="modal-header">
    <h5 class="modal-title" id="finalizePayrollModalLabel">Confirm Payroll Finalization</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <p>Are you sure you want to finalize payroll run <strong>@Model.Name</strong> (Period: @Model.PayrollPeriod.PeriodRange)?</p>
    <p class="text-danger">Once finalized, this payroll run cannot be modified or reversed.</p>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-primary" onclick="confirmFinalizePayroll(@Model.Id)">Finalize Payroll</button>
</div>

<script>
    function confirmFinalizePayroll(id) {
        $.post('@Url.Action("FinalizePayroll", "Payroll")', { id: id })
            .done(function (response) {
                if (response.success) {
                    toastr.success(response.message || 'Payroll finalized successfully');
                    $('#generalModal').modal('hide'); // Hide the general modal
                    $('#payrollRunsTable').DataTable().ajax.reload(); // Reload the DataTable
                } else {
                    toastr.error(response.message || 'An error occurred');
                }
            })
            .fail(function (xhr) {
                var response = xhr.responseJSON;
                toastr.error(response?.message || 'An error occurred while finalizing payroll');
            });
    }
</script>
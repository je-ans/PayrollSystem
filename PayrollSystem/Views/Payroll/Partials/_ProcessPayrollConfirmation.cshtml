@model PayrollRun

<div class="modal-header">
    <h5 class="modal-title" id="processPayrollModalLabel">Confirm Payroll Processing</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <p>Are you sure you want to process payroll run <strong>@Model.Name</strong> (Period: @Model.PayrollPeriod.PeriodRange)?</p>
    <p>This action will initiate the payroll calculation for all eligible employees within this period.</p>
    <p class="text-danger">This action cannot be undone once started.</p>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-success" onclick="confirmProcessPayroll(@Model.Id)">Process Payroll</button>
</div>

<script>
    function confirmProcessPayroll(id) {
        $.post('@Url.Action("ProcessPayroll", "Payroll")', { id: id })
            .done(function (response) {
                if (response.success) {
                    toastr.success(response.message || 'Payroll processed successfully');
                    $('#generalModal').modal('hide'); // Hide the general modal
                    $('#payrollRunsTable').DataTable().ajax.reload(); // Reload the DataTable
                } else {
                    toastr.error(response.message || 'An error occurred');
                }
            })
            .fail(function (xhr) {
                var response = xhr.responseJSON;
                toastr.error(response?.message || 'An error occurred while processing payroll');
            });
    }
</script>
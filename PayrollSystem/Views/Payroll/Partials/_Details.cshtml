@model PayrollRunViewModel

<div class="modal-header">
    <h5 class="modal-title" id="payrollRunDetailsModalLabel">Payroll Run Details - @Model.Name</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <div class="container-fluid">
        <!-- Payroll Run Summary -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Payroll Run Summary</h3>
                        <div class="card-tools">
                            @if (Model.CanProcess)
                            {
                                <button type="button" class="btn btn-success btn-sm process-payroll" data-id="@Model.Id" data-name="@Model.Name">
                                    <i class="fas fa-play"></i> Process Payroll
                                </button>
                            }
                            @if (Model.CanFinalize)
                            {
                                <button type="button" class="btn btn-primary btn-sm finalize-payroll" data-id="@Model.Id" data-name="@Model.Name">
                                    <i class="fas fa-check"></i> Finalize Payroll
                                </button>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="info-box">
                                    <span class="info-box-icon bg-info"><i class="fas fa-users"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total Employees</span>
                                        <span class="info-box-number">@Model.TotalEmployees</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-box">
                                    <span class="info-box-icon bg-success"><i class="fas fa-money-bill-wave"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total Gross Pay</span>
                                        <span class="info-box-number">₱@(Model.TotalGrossPay.HasValue ? Model.TotalGrossPay.Value.ToString("N2") : "0.00")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-box">
                                    <span class="info-box-icon bg-warning"><i class="fas fa-minus-circle"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total Deductions</span>
                                        <span class="info-box-number">₱@(Model.TotalDeductions.HasValue ? Model.TotalDeductions.Value.ToString("N2") : "0.00")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-box">
                                    <span class="info-box-icon bg-primary"><i class="fas fa-hand-holding-usd"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total Net Pay</span>
                                        <span class="info-box-number">₱@(Model.TotalNetPay.HasValue ? Model.TotalNetPay.Value.ToString("N2") : "0.00")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">Name:</dt>
                                    <dd class="col-sm-8">@Model.Name</dd>

                                    <dt class="col-sm-4">Payroll Period:</dt>
                                    <dd class="col-sm-8">@Model.PayrollPeriodName</dd>

                                    <dt class="col-sm-4">Status:</dt>
                                    <dd class="col-sm-8">
                                        @switch (Model.Status)
                                        {
                                            case PayrollStatus.Draft:
                                                <span class="badge badge-warning">Draft</span>
                                                break;
                                            case PayrollStatus.Processing:
                                                <span class="badge badge-info">Processing</span>
                                                break;
                                            case PayrollStatus.Completed:
                                                <span class="badge badge-success">Completed</span>
                                                break;
                                            case PayrollStatus.Cancelled:
                                                <span class="badge badge-danger">Cancelled</span>
                                                break;
                                        }
                                    </dd>
                                </dl>
                            </div>
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">Processed Date:</dt>
                                    <dd class="col-sm-8">@Model.ProcessedDate?.ToString("yyyy-MM-dd HH:mm")</dd>

                                    <dt class="col-sm-4">Processed By:</dt>
                                    <dd class="col-sm-8">@Model.ProcessedByUserName</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payroll Entries -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title m-0">Payroll Entries</h3>
                        @if (Model.CanEdit)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="openHoursEditor(@Model.Id)">
                                <i class="fas fa-edit"></i> Edit Hours by Department
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        <table id="payrollEntriesTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Department</th>
                                    <th>Basic Hours</th>
                                    <th>Overtime Hours</th>
                                    <th>Gross Pay</th>
                                    <th>Total Deductions</th>
                                    <th>Net Pay</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PayrollEntries != null)
                                {
                                    @foreach (var entry in Model.PayrollEntries)
                                    {
                                        <tr>
                                            <td>@entry.EmployeeName</td>
                                            <td>@entry.OrganizationUnitName</td>
                                            <td class="text-right">@(entry.RegularHours.HasValue ? entry.RegularHours.Value.ToString("N2") : "0.00")</td>
                                            <td class="text-right">@(entry.OvertimeHours.HasValue ? entry.OvertimeHours.Value.ToString("N2") : "0.00")</td>
                                            <td class="text-right">₱@(entry.GrossPay.HasValue ? entry.GrossPay.Value.ToString("N2") : "0.00")</td>
                                            <td class="text-right">₱@(entry.TotalDeductions.HasValue ? entry.TotalDeductions.Value.ToString("N2") : "0.00")</td>
                                            <td class="text-right">₱@(entry.NetPay.HasValue ? entry.NetPay.Value.ToString("N2") : "0.00")</td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-info" onclick="viewPayrollEntry(@entry.Id)">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
</div>

<!-- Payroll Entry Details Modal -->
<div class="modal fade" id="payrollEntryModal" tabindex="-1" role="dialog" aria-labelledby="payrollEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="payrollEntryModalLabel">Payroll Entry Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="payrollEntryContent"></div>
            </div>
        </div>
    </div>
</div>
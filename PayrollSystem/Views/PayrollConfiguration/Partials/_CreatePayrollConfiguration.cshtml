@model PayrollConfigurationViewModel

<style>
    .section-header-container {
        position: relative;
    }

    .section-header {
        color: #2c3e50;
        font-weight: 600;
        position: relative;
        display: inline-block;
        padding-right: 1rem;
        background: white;
        z-index: 1;
    }

    .section-divider {
        position: absolute;
        top: 50%;
        width: 100%;
        height: 1px;
        background-color: #e0e0e0;
        z-index: 0;
    }

    .section-divider-wide {
        height: 1px;
        background: linear-gradient(to right, transparent, #e0e0e0, transparent);
    }

    .info-note {
        background-color: #e8f4fd;
        border-left: 4px solid #2196f3;
        padding: 0.75rem;
        margin-top: 1rem;
        border-radius: 4px;
    }

        .info-note i {
            color: #2196f3;
            margin-right: 0.5rem;
        }
</style>

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-body">
            <span asp-validation-summary="All" class="text-danger"></span>
            <form asp-action="Create" method="post" asp-antiforgery="true" id="payrollConfigForm">

                <!-- Basic Configuration Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Basic Configuration</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="Name" type="text" class="form-control floating-input" required placeholder=" ">
                        <label asp-for="Name" class="floating-label">Configuration Name <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="Name" class="text-danger small validation-message"></span>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Rate Calculation Settings Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Rate Calculation Settings</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="WorkingDaysPerMonth" type="number" class="form-control floating-input" value="22" required placeholder=" ">
                        <label asp-for="WorkingDaysPerMonth" class="floating-label">Working Days Per Month <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="WorkingDaysPerMonth" class="text-danger small validation-message"></span>
                    <small class="text-muted">Philippine standard: 22 working days</small>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="WorkingHoursPerDay" type="number" step="0.5" class="form-control floating-input" value="8" required placeholder=" ">
                        <label asp-for="WorkingHoursPerDay" class="floating-label">Working Hours Per Day <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="WorkingHoursPerDay" class="text-danger small validation-message"></span>
                    <small class="text-muted">Standard: 8 hours per day</small>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Attendance Defaults Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Attendance Defaults</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <input asp-for="DefaultWorkStartTime" type="time" class="form-control floating-input" required placeholder=" ">
                                <label asp-for="DefaultWorkStartTime" class="floating-label">Default Work Start Time <span class="text-danger">*</span></label>
                            </div>
                            <span asp-validation-for="DefaultWorkStartTime" class="text-danger small validation-message"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <input asp-for="DefaultWorkEndTime" type="time" class="form-control floating-input" required placeholder=" ">
                                <label asp-for="DefaultWorkEndTime" class="floating-label">Default Work End Time <span class="text-danger">*</span></label>
                            </div>
                            <span asp-validation-for="DefaultWorkEndTime" class="text-danger small validation-message"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <input asp-for="DefaultGracePeriodMinutes" type="number" class="form-control floating-input" value="15" required placeholder=" ">
                                <label asp-for="DefaultGracePeriodMinutes" class="floating-label">Attendance Grace Period</label>
                            </div>
                            <span asp-validation-for="DefaultGracePeriodMinutes" class="text-danger small validation-message"></span>
                            <small class="text-muted">Minutes allowed for a late arrival before being flagged.</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <input asp-for="DefaultHalfDayHours" type="number" step="0.5" class="form-control floating-input" value="4" required placeholder=" ">
                                <label asp-for="DefaultHalfDayHours" class="floating-label">Half Day Threshold</label>
                            </div>
                            <span asp-validation-for="DefaultHalfDayHours" class="text-danger small validation-message"></span>
                            <small class="text-muted">Minimum hours for half-day attendance.</small>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <input asp-for="DefaultBreakDurationMinutes" type="number" class="form-control floating-input" value="60" required placeholder=" ">
                                <label asp-for="DefaultBreakDurationMinutes" class="floating-label">Default Break Duration</label>
                            </div>
                            <span asp-validation-for="DefaultBreakDurationMinutes" class="text-danger small validation-message"></span>
                            <small class="text-muted">Standard break time used for auto calculations.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <input asp-for="DefaultAutomaticPairingWindowMinutes" type="number" class="form-control floating-input" value="15" required placeholder=" ">
                                <label asp-for="DefaultAutomaticPairingWindowMinutes" class="floating-label">Auto Pairing Window</label>
                            </div>
                            <span asp-validation-for="DefaultAutomaticPairingWindowMinutes" class="text-danger small validation-message"></span>
                            <small class="text-muted">Automatic pairing window for punches during attendance generation.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3">
                            <div class="custom-control custom-checkbox">
                                <input asp-for="UseWeekendAsDayOff" type="checkbox" class="custom-control-input" id="useWeekendAsDayOff" />
                                <label class="custom-control-label" for="useWeekendAsDayOff">Weekend is Day Off</label>
                            </div>
                            <span asp-validation-for="UseWeekendAsDayOff" class="text-danger small validation-message"></span>
                            <small class="text-muted d-block mt-1">When checked, Saturdays and Sundays are automatically treated as non-working days unless punches exist.</small>
                        </div>
                    </div>
                </div>

                <div class="section-divider-wide my-4"></div>

                <div class="section-header-container mb-4">
                    <h6 class="section-header">Night Differential &amp; Overtime Rules</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <input asp-for="NightDifferentialStartTime" type="time" class="form-control floating-input" value="22:00" required placeholder=" ">
                                <label asp-for="NightDifferentialStartTime" class="floating-label">ND Start</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <input asp-for="NightDifferentialEndTime" type="time" class="form-control floating-input" value="06:00" required placeholder=" ">
                                <label asp-for="NightDifferentialEndTime" class="floating-label">ND End</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <input asp-for="MinimumOvertimeMinutes" type="number" class="form-control floating-input" value="30" required placeholder=" ">
                                <label asp-for="MinimumOvertimeMinutes" class="floating-label">Min OT Minutes</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3">
                            <div class="input-container">
                                <select asp-for="OvertimeRoundingRule" asp-items="Html.GetEnumSelectList<PayrollSystem.Models.OvertimeRoundingRule>()" class="form-control floating-input" required></select>
                                <label asp-for="OvertimeRoundingRule" class="floating-label">OT Rounding</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3">
                            <div class="custom-control custom-checkbox">
                                <input asp-for="RequireOvertimeApproval" type="checkbox" class="custom-control-input" id="requireOvertimeApproval" checked />
                                <label class="custom-control-label" for="requireOvertimeApproval">Require Overtime Approval</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Contribution Table Years Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Contribution Table Years</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="TaxTableYear" type="number" class="form-control floating-input" value="@DateTime.Now.Year" required placeholder=" ">
                        <label asp-for="TaxTableYear" class="floating-label">Tax Table Year <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="TaxTableYear" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="SSSTableYear" type="number" class="form-control floating-input" value="@DateTime.Now.Year" required placeholder=" ">
                        <label asp-for="SSSTableYear" class="floating-label">SSS Table Year <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="SSSTableYear" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="PhilHealthTableYear" type="number" class="form-control floating-input" value="@DateTime.Now.Year" required placeholder=" ">
                        <label asp-for="PhilHealthTableYear" class="floating-label">PhilHealth Table Year <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="PhilHealthTableYear" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="PagIbigTableYear" type="number" class="form-control floating-input" value="@DateTime.Now.Year" required placeholder=" ">
                        <label asp-for="PagIbigTableYear" class="floating-label">Pag-IBIG Table Year <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="PagIbigTableYear" class="text-danger small validation-message"></span>
                </div>

                <div class="info-note mt-3">
                    <i class="fas fa-info-circle"></i>
                    <small>These years determine which contribution tables will be used for calculations. Tables must exist for the selected years.</small>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Company Information Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Company Information</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="CompanyName" type="text" class="form-control floating-input" placeholder=" ">
                        <label asp-for="CompanyName" class="floating-label">Company Name</label>
                    </div>
                    <span asp-validation-for="CompanyName" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="CompanyTIN" type="text" class="form-control floating-input" placeholder="XXX-XXX-XXX-XXX">
                        <label asp-for="CompanyTIN" class="floating-label">TIN (Tax Identification Number)</label>
                    </div>
                    <span asp-validation-for="CompanyTIN" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="CompanySSSNumber" type="text" class="form-control floating-input" placeholder="XX-XXXXXXX-X">
                        <label asp-for="CompanySSSNumber" class="floating-label">SSS Number</label>
                    </div>
                    <span asp-validation-for="CompanySSSNumber" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="CompanyPhilHealthNumber" type="text" class="form-control floating-input" placeholder="XX-XXXXXXXXX-X">
                        <label asp-for="CompanyPhilHealthNumber" class="floating-label">PhilHealth Number</label>
                    </div>
                    <span asp-validation-for="CompanyPhilHealthNumber" class="text-danger small validation-message"></span>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="CompanyPagIbigNumber" type="text" class="form-control floating-input" placeholder="XXXX-XXXX-XXXX">
                        <label asp-for="CompanyPagIbigNumber" class="floating-label">Pag-IBIG Number</label>
                    </div>
                    <span asp-validation-for="CompanyPagIbigNumber" class="text-danger small validation-message"></span>
                </div>

                <div class="info-note mt-3">
                    <i class="fas fa-building"></i>
                    <small>Company information will appear on generated payslips. Format: TIN (XXX-XXX-XXX-XXX), SSS (XX-XXXXXXX-X), PhilHealth (XX-XXXXXXXXX-X), Pag-IBIG (XXXX-XXXX-XXXX)</small>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Effective Period Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Effective Period</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="input-container">
                        <input asp-for="EffectiveDate" type="datetime-local" class="form-control floating-input" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required placeholder=" ">
                        <label asp-for="EffectiveDate" class="floating-label">Effective Date <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="EffectiveDate" class="text-danger small validation-message"></span>
                </div>

                <div class="section-divider-wide my-4"></div>

                <!-- Settings Section -->
                <div class="section-header-container mb-4">
                    <h6 class="section-header">Settings</h6>
                    <div class="section-divider"></div>
                </div>

                <div class="form-group mt-3">
                    <div class="custom-control custom-switch">
                        <input asp-for="IsActive" type="checkbox" class="custom-control-input" id="isActiveSwitch" checked>
                        <label class="custom-control-label" for="isActiveSwitch">Is Active</label>
                    </div>
                    <small class="text-muted d-block mt-1">Only one active configuration can be used at a time</small>
                </div>

            </form>
        </div>
    </div>
</div>

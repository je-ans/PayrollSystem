@model DepartmentViewModel

<div class="container-fluid">
    <span asp-validation-summary="All" class="text-danger"></span>
    <form asp-action="EditDepartment">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <div class="input-container">
                <input asp-for="DepartmentName" type="text" class="form-control floating-input" required placeholder=" ">
                <label asp-for="DepartmentName" class="floating-label">Department Name</label>
            </div>
            <span asp-validation-for="DepartmentName" class="text-danger validation-message"></span>
        </div>

        <div class="form-group">
            <div class="input-container">
                <input asp-for="DepartmentDescription" type="text" class="form-control floating-input" required placeholder=" ">
                <label asp-for="DepartmentDescription" class="floating-label">Description</label>
            </div>
            <span asp-validation-for="DepartmentDescription" class="text-danger validation-message"></span>
        </div>

        <div class="form-group">
            <div class="custom-control custom-switch">
                <input asp-for="IsActive" type="checkbox" class="custom-control-input" id="statusSwitch">
                <label class="custom-control-label" for="statusSwitch">Active</label>
            </div>
        </div>
    </form>
</div>

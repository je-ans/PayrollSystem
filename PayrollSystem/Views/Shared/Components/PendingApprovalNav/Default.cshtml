@model int
@{
    var isActive = ViewBag.ActiveMenu as string == "PendingApprovals"
        || ViewBag.ActiveLink as string == "PendingApprovals";
}

<li class="nav-item">
    <a class="nav-link @(isActive ? "active" : "")"
       asp-controller="PendingApproval" asp-action="Index">
        <i class="nav-icon fas fa-tasks"></i>
        <p>
            Pending Approvals
            @if (Model > 0)
            {
                <span class="badge badge-warning navbar-queue-badge right">@(Model > 99 ? "99+" : Model.ToString())</span>
            }
        </p>
    </a>
</li>

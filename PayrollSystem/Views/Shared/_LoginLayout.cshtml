<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | @(ViewBag.SystemInfo?.ShortName ?? "SystemName")</title>
    <link rel="icon" type="image/x-icon" href="@(ViewBag.SystemInfo?.LogoUrl != null ? Url.Content(ViewBag.SystemInfo.LogoUrl) : Url.Content("favicon.ico"))" />

    <partial name="_PluginLinks" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    @RenderBody()
</body>
</html>

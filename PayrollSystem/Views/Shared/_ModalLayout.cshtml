<!-- Create Modal -->
<div class="modal fade" id="createModal" role="dialog" data-backdrop="static" aria-labelledby="sharedModalLabel" data-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="sharedModalLabel">Modal Title</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="createModalContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="createModalSave">
                    <i class="fas fa-save"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" data-backdrop="static" aria-labelledby="editModalLabel" data-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Edit User</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="editModalContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="editModalSave">Save changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" data-backdrop="static" aria-labelledby="deleteModalLabel" data-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="close text-light" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="deleteModalContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="deleteModalSave">Yes, Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="viewModal" tabindex="-1" data-backdrop="static" aria-labelledby="viewModalLabel" data-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="viewModalContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="createMultiStepFormModal" tabindex="-1" data-backdrop="static" aria-labelledby="createMultiStepFormModalLabel" data-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createMultiStepFormModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="createMultiStepFormModalContent"></div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <div class="row">
                    <div class="col">
                        <button type="button" class="btn btn-action btn-prev prev-step">
                            <i class="fas fa-arrow-left mr-2"></i>
                            <span>Back</span>
                        </button>
                    </div>
                    <div class="col">
                        <button type="button" id="createMultiStepFormModalSave" class="btn btn-action btn-next save-button">
                            <i class="fas fa-save mr-2"></i>
                            <span>Save</span>
                        </button>
                    </div>
                    <div class="col pr-1">
                        <button type="button" class="btn btn-action btn-next next-step">
                            <span>Next</span>
                            <i class="fas fa-arrow-right ml-2"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Document Customization Modal -->
<div class="modal fade" id="documentCustomizeModal" tabindex="-1" data-backdrop="static" role="dialog" aria-labelledby="documentCustomizeModalLabel" data-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentCustomizeModalLabel">Customize Document Print Settings</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="documentCustomizeForm">
                    <ul class="nav nav-tabs" id="customizeTabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="header-tab" data-toggle="tab" href="#headerCustomization" role="tab">Header</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="footer-tab" data-toggle="tab" href="#footerCustomization" role="tab">Footer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="layout-tab" data-toggle="tab" href="#layoutCustomization" role="tab">Layout</a>
                        </li>
                    </ul>

                    <div class="tab-content mt-3" id="customizeTabsContent">
                        <!-- Header Customization -->
                        <div class="tab-pane fade show active" id="headerCustomization" role="tabpanel">
                            <div class="form-group">
                                <label for="headerTitle">Document Title</label>
                                <input type="text" class="form-control" id="headerTitle" name="headerTitle" placeholder="OBLIGATION REQUEST AND STATUS / BUDGET UTILIZATION REQUEST AND STATUS">
                            </div>
                            <div class="form-group">
                                <label for="entityName">Entity Name</label>
                                <input type="text" class="form-control" id="entityName" name="entityName" placeholder="Enter entity name">
                            </div>
                            <div class="form-group">
                                <label for="headerLogo">Upload Logo (optional)</label>
                                <div class="input-group">
                                    <div class="custom-file">
                                        <input type="file" class="custom-file-input" id="headerLogo" name="headerLogo">
                                        <label class="custom-file-label" for="headerLogo">Choose file</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="showAppendix" name="showAppendix" checked>
                                <label class="form-check-label" for="showAppendix">Show Appendix Number</label>
                            </div>
                        </div>

                        <!-- Footer Customization -->
                        <div class="tab-pane fade" id="footerCustomization" role="tabpanel">
                            <div class="form-group">
                                <label for="footerText">Footer Text</label>
                                <textarea class="form-control" id="footerText" name="footerText" rows="2" placeholder="Enter footer text"></textarea>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="showPageNumbers" name="showPageNumbers" checked>
                                <label class="form-check-label" for="showPageNumbers">Show Page Numbers</label>
                            </div>
                        </div>

                        <!-- Layout Customization -->
                        <div class="tab-pane fade" id="layoutCustomization" role="tabpanel">
                            <div class="form-group">
                                <label for="fontSize">Font Size</label>
                                <select class="form-control" id="fontSize" name="fontSize">
                                    <option value="9">Small (9pt)</option>
                                    <option value="11" selected>Medium (11pt)</option>
                                    <option value="12">Large (12pt)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="fontFamily">Font Family</label>
                                <select class="form-control" id="fontFamily" name="fontFamily">
                                    <option value="Arial, sans-serif" selected>Arial</option>
                                    <option value="'Times New Roman', serif">Times New Roman</option>
                                    <option value="Calibri, sans-serif">Calibri</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="pageOrientation">Page Orientation</label>
                                <select class="form-control" id="pageOrientation" name="pageOrientation">
                                    <option value="portrait" selected>Portrait</option>
                                    <option value="landscape">Landscape</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="pageMargins">Page Margins (inches)</label>
                                <div class="row">
                                    <div class="col-md-3">
                                        <input type="number" class="form-control" id="marginTop" name="marginTop" placeholder="Top" value="0.5" step="0.1" min="0.1" max="2">
                                        <small>Top</small>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="number" class="form-control" id="marginRight" name="marginRight" placeholder="Right" value="0.5" step="0.1" min="0.1" max="2">
                                        <small>Right</small>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="number" class="form-control" id="marginBottom" name="marginBottom" placeholder="Bottom" value="0.5" step="0.1" min="0.1" max="2">
                                        <small>Bottom</small>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="number" class="form-control" id="marginLeft" name="marginLeft" placeholder="Left" value="0.5" step="0.1" min="0.1" max="2">
                                        <small>Left</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveCustomizationBtn">Save & Apply</button>
            </div>
        </div>
    </div>
</div>
<script>

    //For Table Layout
    $(document).ready(function () {
        $('#myTable').DataTable({
            responsive: true,
            searching: true, // Enable search (default is true)
            ordering: true,  // Enable column ordering (default is true)
            paging: true,    // Enable pagination (default is true)
            info: true,      // Show information summary (default is true)
            fixedHeader: true, // Make table header sticky
            // columnDefs: [
            //     { orderable: false, targets: [0] } // Adjust column index as needed
            // ],
            order: [[0, 'asc']],
            language: {
                emptyTable: "No data available." // Custom message
            }
        });
    });

</script>


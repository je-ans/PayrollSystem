        <script>
            window.appAuth = {
                isPrivileged: @System.Text.Json.JsonSerializer.Serialize(PermissionHelper.IsPrivilegedUser(User)),
                permissions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PermissionHelper.GetPermissionTokens(User).ToArray()))
            };
        </script>
        <script src="~/js/permissions.js" asp-append-version="true"></script>
        <script src="~/js/print-preview.js" asp-append-version="true"></script>
        <script src="~/js/notification-handler.js" asp-append-version="true"></script>
        <script src="~/js/sidebar.js" asp-append-version="true"></script>
        <script src="~/js/lib/signalr/dist/browser/signalr.js"></script>

        @await RenderSectionAsync("Scripts", required: false)

        <script>
            //====================================================================================
            // Notification Functionality (Preserved from original)
            //====================================================================================

            // Optional: Add maintenance mode class to disable interactions
            document.addEventListener('DOMContentLoaded', function() {
                const isMaintenanceMode = false; // Set to false when maintenance is done

                if (isMaintenanceMode) {
                    document.getElementById('notifDropdown').classList.add('maintenance-mode');
                    document.getElementById('markAllReadBtn').classList.add('maintenance-mode');
                    document.getElementById('seeAllNotifLink').classList.add('maintenance-mode');

                    // Optionally hide the badge during maintenance
                    document.getElementById('notifBadge').style.display = 'none';
                }
            });

            (function () {
                const badge = document.getElementById('notifBadge');
                const list = document.getElementById('notifList');
                const dropdown = document.getElementById('notifDropdown');
                const markAllBtn = document.getElementById('markAllReadBtn');
                const headerCount = document.getElementById('notifHeaderCount');
                const pendingReviewBadge = document.getElementById('pendingReviewBadge');

                if (!badge || !list || !dropdown || !pendingReviewBadge) return;

                // Constants
                const NotificationType = {
                    ApprovalNeeded: 0,
                    Approved: 1
                };

                const ApprovalStatus = {
                    ForReview: 0,
                    Approved: 1
                };

                // Utility: Escape HTML to prevent XSS
                function escapeHtml(text) {
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                }

                function formatMessageWithStatusAndType(msg, status, type) {
                    const escapedMsg = escapeHtml(msg.replace(/\\[.*?\\]/g, '').trim());

                    if (status === ApprovalStatus.ForReview) {
                        return `<span class='badge badge-warning mr-1'>For Review</span> ${escapedMsg}`;
                    } else if (status === ApprovalStatus.Approved && type === NotificationType.Approved) {
                        return `<span class='badge badge-success mr-1'>Approved</span> ${escapedMsg}`;
                    }
                    return escapedMsg;
                }

                function timeAgo(dateInput) {
                    try {
                        const date = new Date(dateInput);
                        if (isNaN(date.getTime())) return '';

                        const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
                        const intervals = [
                            { label: 'year', secs: 31536000 },
                            { label: 'month', secs: 2592000 },
                            { label: 'day', secs: 86400 },
                            { label: 'hour', secs: 3600 },
                            { label: 'min', secs: 60 }
                        ];

                        for (const i of intervals) {
                            const v = Math.floor(seconds / i.secs);
                            if (v >= 1) return `${v} ${i.label}${v > 1 ? 's' : ''} ago`;
                        }
                        return 'just now';
                    } catch (e) {
                        console.error('Error formatting date:', e);
                        return '';
                    }
                }

                function updateBadge(count) {
                    const safeCount = Math.max(0, parseInt(count) || 0);

                    if (safeCount > 0) {
                        badge.style.display = '';
                        badge.textContent = safeCount > 99 ? '99+' : safeCount;
                        if (headerCount) headerCount.textContent = `• ${safeCount} unread`;
                    } else {
                        badge.style.display = 'none';
                        if (headerCount) headerCount.textContent = '';
                    }
                }

                function updatePendingReviewBadge(count) {
                    const safeCount = Math.max(0, parseInt(count) || 0);
                    pendingReviewBadge.textContent = safeCount > 99 ? '99+' : safeCount;
                    pendingReviewBadge.style.display = safeCount > 0 ? '' : 'none';
                }

                function renderNotifications(items) {
                    if (!Array.isArray(items) || items.length === 0) {
                        list.innerHTML = "<div class='p-3 text-center text-muted small'>No notifications.</div>";
                        if (headerCount) headerCount.textContent = '';
                        return;
                    }

                    list.innerHTML = items.map(n => {
                        const safeId = escapeHtml(String(n.id || ''));
                        const safeUrl = escapeHtml(String(n.link || ''));
                        const safeMessage = escapeHtml(String(n.message || ''));
                        const formattedMessage = formatMessageWithStatusAndType(
                            n.message || '',
                            n.registryApprovalStatus,
                            n.type
                        );

                        return `
                            <a href="javascript:void(0)"
                               class="dropdown-item d-flex align-items-start text-break notification-link ${n.isRead ? '' : 'bg-light'}"
                               data-id="${safeId}"
                               data-url="${safeUrl}"
                               data-title="Registry Preview"
                               data-message="${safeMessage}"
                               data-type="${n.type || 0}"
                               data-registry-approval-status="${n.registryApprovalStatus || 0}">
                                <div class="mr-2 mt-1">
                                    <i class="fa ${n.isRead ? 'fa-envelope-open text-secondary' : 'fa-envelope text-primary'}"></i>
                                </div>
                                <div class="small flex-fill text-break">
                                    <div class="text-break">${formattedMessage}</div>
                                    <div class="text-muted mt-1">${timeAgo(n.createdAt)}</div>
                                </div>
                                ${n.isRead ? '' : '<span class="badge badge-warning ml-2">New</span>'}
                            </a>
                        `;
                    }).join('');

                    // Initialize notification handlers if available
                    if (typeof NotificationHandler !== 'undefined') {
                        NotificationHandler.initialize('#notifList', {
                            onMarkRead: () => {/* No API call, rely on SignalR */}
                        });
                    }

                    // Hide dropdown when notification is clicked
                    list.querySelectorAll('a.notification-link').forEach(a => {
                        a.addEventListener('click', () => {
                            if (typeof $ !== 'undefined' && $(dropdown).dropdown) {
                                $(dropdown).dropdown('hide');
                            }
                        });
                    });
                }

                // SignalR setup with comprehensive data payload
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect()
                    .build();

                // PRIMARY: Receive complete notification payload from SignalR
                connection.on("ReceiveNotificationUpdate", function (payload) {
                    console.log("Received notification update:", payload);

                    try {
                        // Update all UI elements from single SignalR message
                        if (typeof payload.unreadCount !== 'undefined') {
                            updateBadge(payload.unreadCount);
                        }

                        if (typeof payload.pendingReviewCount !== 'undefined') {
                            updatePendingReviewBadge(payload.pendingReviewCount);
                        }

                        if (Array.isArray(payload.latestNotifications)) {
                            renderNotifications(payload.latestNotifications);
                        }
                    } catch (e) {
                        console.error('Error processing SignalR payload:', e);
                        // If SignalR payload is malformed or processing fails, consider server-side logging or user notification
                    }
                });

                connection.start()
                    .then(() => {
                        console.log("SignalR connected");
                        // Request initial data from the server upon successful connection
                        connection.invoke("RequestNotificationUpdate");
                    })
                    .catch(err => console.error("SignalR connection error:", err));

                connection.onreconnected(() => {
                    console.log("SignalR reconnected - requesting latest data");
                    // Request fresh data on reconnection
                    connection.invoke("RequestNotificationUpdate");
                });

                connection.onclose(error => {
                    console.error("SignalR connection closed:", error);
                });

                // Initialize on DOMContentLoaded
                document.addEventListener('DOMContentLoaded', function () {
                    // Initial UI state - empty, waiting for SignalR to connect and push data
                    updateBadge(0);
                    updatePendingReviewBadge(0);
                    renderNotifications([]);

                    // Trigger initial request if already connected (e.g., fast page loads, browser back/forward)
                    if (connection.state === signalR.HubConnectionState.Connected) {
                        connection.invoke("RequestNotificationUpdate");
                    }

                    // Refresh when dropdown is opened (optional - can be removed if SignalR is reliable)
                    dropdown.addEventListener('click', function () {
                        // If the list is empty or shows 'No notifications', request an update
                        if (list.children.length === 0 ||
                            list.innerHTML.includes('No notifications') ||
                            list.innerHTML.includes('Loading...')) {
                            connection.invoke("RequestNotificationUpdate");
                        }
                    });

                    // Mark all as read
                    if (markAllBtn) {
                        markAllBtn.addEventListener('click', async function (e) {
                            e.preventDefault();
                            try {
                                const res = await fetch('/Notification/MarkAllNotificationsRead', {
                                    method: 'POST'
                                });
                                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                                // After marking as read, server should push updated data via SignalR
                                // (triggered by the MarkAllNotificationsRead action calling PushNotificationUpdate)
                            } catch (e) {
                                console.error('Failed to mark all as read:', e);
                            }
                        });
                    }
                });
            })();

            //====================================================================================
            // Logout Confirmation (Preserved from original)
            //====================================================================================
            function confirmLogout(logoutUrl) {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You will be logged out!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, logout',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = logoutUrl;
                    }
                });
            }

            //====================================================================================
            // Loading Spinner (Preserved from original)
            //====================================================================================

            // Hide spinner when the window has fully loaded all resources
            window.onload = function() {
                var spinnerOverlay = document.getElementById('spinnerOverlay');
                if (spinnerOverlay) {
                    // Add a small delay to ensure the spinner is seen, even on fast loads
                    setTimeout(function() {
                        spinnerOverlay.classList.remove('show');
                    }, 100); // 100ms delay
                }
            };

            document.addEventListener('DOMContentLoaded', function() {
                var spinnerOverlay = document.getElementById('spinnerOverlay');
                // Only show spinner for actual page navigations (not anchor links, javascript:, or external links)
                document.querySelectorAll('a[href]').forEach(function(link) {
                    link.addEventListener('click', function(event) {
                        var href = this.getAttribute('href');
                        var isTabLink = this.getAttribute('data-toggle') === 'tab';
                        if (href && href !== '#' && !href.startsWith('javascript:') && !this.target && !event.ctrlKey && !event.metaKey && !isTabLink) {
                            if (spinnerOverlay) {
                                spinnerOverlay.classList.add('show');
                            }
                        }
                    });
                });

                // Restore scroll position for this URL (reload only)
                try {
                    var scrollKey = 'scroll-pos:' + location.pathname + location.search;
                    var navEntry = (performance && performance.getEntriesByType) ? performance.getEntriesByType('navigation')[0] : null;
                    var navType = navEntry ? navEntry.type : (performance && performance.navigation ? (performance.navigation.type === 1 ? 'reload' : '') : '');
                    if (navType === 'reload') {
                        var savedY = sessionStorage.getItem(scrollKey);
                        if (savedY !== null && !location.hash) {
                            setTimeout(function () {
                                window.scrollTo(0, parseInt(savedY, 10) || 0);
                            }, 0);
                        }
                    }
                } catch (e) { }
            });

            // Ensure spinner is shown when page starts unloading (for back/forward navigation or form submissions)
            window.addEventListener('beforeunload', function() {
                var spinnerOverlay = document.getElementById('spinnerOverlay');
                if (spinnerOverlay) {
                    spinnerOverlay.classList.add('show');
                }
                // Save current scroll position for this URL
                try {
                    var y = window.scrollY || document.documentElement.scrollTop || 0;
                    sessionStorage.setItem('scroll-pos:' + location.pathname + location.search, String(y));
                } catch (e) { }
            });


            //====================================================================================
            // Scroll to top button functionality (Preserved from original)
            //====================================================================================

            $(document).ready(function () {
                var backToTopButton = $('#back-to-top');
                // backToTopButton.addClass('d-none'); // Initially hide the button

                // Show or hide the button based on scroll position
                $(window).scroll(function () {
                    if ($(this).scrollTop() > 100) { // Show button after scrolling 100px
                        backToTopButton.removeClass('back-to-top-hidden');
                    } else {
                        backToTopButton.addClass('back-to-top-hidden');
                    }
                });

                // Smooth scroll to top when button is clicked
                backToTopButton.on('click', function (e) {
                    e.preventDefault();
                    $('html, body').animate({ scrollTop: 0 }, 500); // Scroll duration 500ms
                });
            });


            // ====================================================================================
            // Service Worker (Preserved from original)
            // ====================================================================================

            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('/service-worker.js')
                        .then(function (registration) {
                            // Registration successful
                            console.log('ServiceWorker registration successful with scope: ', registration.scope);
                        }, function (err) {
                            // Registration failed
                            console.log('ServiceWorker registration failed: ', err);
                        });
                });
            }
        </script>
    </body>
    </html>
}
else
{
    // User is not authenticated - redirect to login
    Context.Response.Redirect("/Account/Login");
}
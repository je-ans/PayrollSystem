@model UserViewModel

<div class="modal-body">
    <div class="text-center mb-4">
        <img src="@(string.IsNullOrEmpty(Model.ProfilePicture) ? Url.Content("~/image/default_user.png") : Url.Content("~/uploads/" + Model.ProfilePicture))"
             alt="Profile"
             class="img-fluid rounded-circle shadow-lg border border-4 border-light"
             style="width: 120px; height: 120px; object-fit: cover; background: linear-gradient(to bottom, #ffffff, #f8f9fa); padding: 5px;">

        <h4 class="mt-3 font-weight-bold text-dark">@Model.FullName</h4>
        <p class="text-muted"><i class="fa fa-envelope"></i> @Model.Email</p>
    </div>

    @if (!Model.CanDelete)
    {
        <div class="alert alert-warning mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i>
            This user cannot be deleted because it is referenced in other records.
        </div>
    }

    <table class="table table-striped align-middle">
        <tbody>
            <tr>
                <th class="text-end font-weight-semibold bg-light">Username</th>
                <td class="text-dark">@Model.UserName</td>
            </tr>
            <tr>
                <th class="text-end font-weight-semibold bg-light">Department</th>
                <td class="text-dark">@Model.DepartmentName</td>
            </tr>
            <tr>
                <th class="text-end font-weight-semibold bg-light">Designation</th>
                <td class="text-dark">@Model.DesignationName</td>
            </tr>
            <tr>
                <th class="text-end font-weight-semibold bg-light">Phone Number</th>
                <td class="text-dark">@Model.PhoneNumber</td>
            </tr>
            <tr>
                <th class="text-end font-weight-semibold bg-light">Role</th>
                <td class="text-dark">@Model.RoleName</td>
            </tr>
			<tr>
				<th class="text-end font-weight-semibold bg-light">Custom Name</th>
				<td class="text-dark">@Model.CustomizeName</td>
			</tr>
			<tr>
				<th class="text-end font-weight-semibold bg-light">Custom Designation</th>
				<td class="text-dark">@Model.CustomizeDesignation</td>
			</tr>
            <tr>
				<th class="text-end font-weight-semibold bg-light">Status</th>
                <td class="text-dark">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        <i class="@(Model.IsActive ? "fa fa-check-circle text-white" : "fa fa-times-circle text-white")"></i>
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
</div>


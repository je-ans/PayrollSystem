@model AssignRolePermission

@{
    ViewData["Title"] = "Create";
}

<div class="container-fluid">
    <span asp-validation-summary="All" class="text-danger"></span>
    <form asp-action="Create" method="post" asp-antiforgery="true" id="systemTaskForm">
        
        <div class="form-group">
            <div class="input-container">
                <select asp-for="TaskId" id="CreateTaskId" class="form-control floating-input select2 taskId-select" asp-items="ViewBag.TaskId" value="">
                    <option value="" selected disabled hidden>--Select Task Name--</option>
                </select>
                <label asp-for="TaskId" class="floating-label">TaskId</label>
            </div>
            <span asp-validation-for="TaskId" class="text-danger validation-message"></span>
        </div>

        <div class="form-group">
            <div class="input-container">
                <select asp-for="RoleId" id="CreateRoleId" class="form-control floating-input select2 role-select" asp-items="ViewBag.RoleId" value="">
                    <option value="" selected disabled hidden>--Select a Role--</option>
                </select>
                <label asp-for="RoleId" class="floating-label">Role</label>
            </div>
            <span asp-validation-for="RoleId" class="text-danger validation-message"></span>
        </div>
    </form>
</div>


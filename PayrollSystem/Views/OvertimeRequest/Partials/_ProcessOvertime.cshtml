@using PayrollSystem.Utility
@model OvertimeRequestProcessViewModel

<link rel="stylesheet" href="~/css/dtr-modals.css" asp-append-version="true" />

<form id="processOvertimeForm" method="post" asp-action="Process" asp-controller="OvertimeRequest">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ReviewAction" />

    <div class="dm-modal">
        <div class="dm-process-header">
            <div>
                <h6>@EnumHelper.GetDisplayName(Model.ReviewAction) overtime request</h6>
                <small>@Model.DateDisplay</small>
            </div>
            <span class="dm-status @(Model.ReviewAction == OvertimeStatus.Approved ? "dm-status--approved" : "dm-status--rejected")">
                @Model.ReviewAction
            </span>
        </div>

        <div class="dm-section">
            <div class="dm-section-header">
                <i class="fas fa-user"></i>
                Request summary
            </div>
            <div class="dm-section-body">
                @await Html.PartialAsync("~/Views/Shared/Partials/_ProcessRequestSummary.cshtml", Model.Summary)

                <div class="dm-detail-grid dm-detail-grid--compact mt-3">
                    <div class="dm-detail-item dm-detail-item--full">
                        <span class="dm-detail-label">OT dates</span>
                        <span class="dm-detail-value">@Model.DateDisplay</span>
                    </div>
                    <div class="dm-detail-item">
                        <span class="dm-detail-label">Daily time</span>
                        <span class="dm-detail-value dm-detail-value--muted">@Model.RequestedTimes</span>
                    </div>
                    <div class="dm-detail-item">
                        <span class="dm-detail-label">Lunch break</span>
                        <span class="dm-detail-value dm-detail-value--muted">
                            @(Model.HasLunchBreak && !string.IsNullOrWhiteSpace(Model.LunchBreakDisplay)
                                ? Model.LunchBreakDisplay
                                : "None")
                        </span>
                    </div>
                    <div class="dm-detail-item">
                        <span class="dm-detail-label">Net hours / day</span>
                        <span class="dm-detail-value">
                            @Model.HoursPerDay.ToString("0.##") hrs
                            <span class="text-muted">(window @Model.GrossHoursPerDay.ToString("0.##")h)</span>
                        </span>
                    </div>
                    <div class="dm-detail-item">
                        <span class="dm-detail-label">Total net hours</span>
                        <span class="dm-detail-value">
                            @Model.RequestedHours.ToString("0.##") hrs
                            @if (Model.DayCount > 1)
                            {
                                <span class="text-muted">(× @Model.DayCount days)</span>
                            }
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.DayTypeName))
                    {
                        <div class="dm-detail-item dm-detail-item--full">
                            <span class="dm-detail-label">Day type</span>
                            <span class="dm-detail-value dm-detail-value--muted">@Model.DayTypeName</span>
                        </div>
                    }
                </div>

                <div class="mt-3">
                    <span class="dm-detail-label d-block mb-1">Reason</span>
                    <p class="dm-reason-box mb-0">@Model.Reason</p>
                </div>
            </div>
        </div>

        @if (Model.ReviewAction == OvertimeStatus.Approved)
        {
            <div class="dm-section">
                <div class="dm-section-header">
                    <i class="fas fa-check-circle"></i>
                    Confirm approval
                </div>
                <div class="dm-section-body">
                    <div class="dm-alert-banner dm-alert-banner--info mb-0">
                        <i class="fas fa-info-circle"></i>
                        <div>
                            You are approving the request exactly as submitted
                            (@Model.RequestedTimes, @Model.RequestedHours.ToString("0.##") hrs total).
                            If the dates or times need to change, reject the request and ask the employee to submit a new one.
                            After final approval this becomes Pending OT for payroll import.
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="dm-section">
            <div class="dm-section-header">
                <i class="fas fa-sticky-note"></i>
                Reviewer notes
            </div>
            <div class="dm-section-body">
                @if (Model.ReviewAction == OvertimeStatus.Rejected)
                {
                    <div class="dm-alert-banner dm-alert-banner--warning mb-3">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>Please provide a reason when rejecting this request. The employee can submit a new request with corrected dates or times.</div>
                    </div>
                    <label asp-for="ReviewNotes" class="dm-form-label">Rejection notes</label>
                    <textarea asp-for="ReviewNotes"
                              class="form-control dm-form-control"
                              rows="3"
                              required
                              placeholder="Enter reason for rejection…"></textarea>
                    <span asp-validation-for="ReviewNotes" class="text-danger validation-message"></span>
                }
                else
                {
                    <label asp-for="ReviewNotes" class="dm-form-label">Notes (optional)</label>
                    <textarea asp-for="ReviewNotes"
                              class="form-control dm-form-control"
                              rows="2"
                              placeholder="Optional internal notes…"></textarea>
                }
            </div>
        </div>
    </div>
</form>

@model AllowanceDetailsViewModel

<div class="container">
    <table class="table table-bordered table-hover mb-4">
        <tr>
            <th class="bg-light">Allowance Name</th>
            <td>@Model.Allowance.AllowanceName</td>
        </tr>
        <tr>
            <th class="bg-light">Allowance Type</th>
            <td>@Model.Allowance.AllowanceTypeName</td>
        </tr>
        <tr>
            <th class="bg-light">Code</th>
            <td>@(string.IsNullOrEmpty(Model.Allowance.Code) ? "—" : Model.Allowance.Code)</td>
        </tr>
        <tr>
            <th class="bg-light">Amount</th>
            <td>₱@Model.Allowance.Amount.ToString("N2")</td>
        </tr>
        <tr>
            <th class="bg-light">Frequency</th>
            <td>@Model.Allowance.Frequency</td>
        </tr>
        <tr>
            <th class="bg-light">Taxable</th>
            <td>
                @if (Model.Allowance.IsTaxable)
                {
                    <span class="badge bg-warning text-dark">Yes</span>
                }
                else
                {
                    <span class="badge bg-secondary">No</span>
                }
            </td>
        </tr>
        <tr>
            <th class="bg-light">Mandatory</th>
            <td>
                @if (Model.Allowance.IsMandatory)
                {
                    <span class="badge bg-warning text-dark">Yes</span>
                }
                else
                {
                    <span class="badge bg-secondary">No</span>
                }
            </td>
        </tr>
        <tr>
            <th class="bg-light">Effective Date</th>
            <td>@((Model.Allowance.EffectiveDate == default(DateTime)) ? "—" : Model.Allowance.EffectiveDate.ToString("MMMM dd, yyyy"))</td>
        </tr>
        <tr>
            <th class="bg-light">End Date</th>
            <td>@(Model.Allowance.EndDate.HasValue ? Model.Allowance.EndDate.Value.ToString("MMMM dd, yyyy") : "—")</td>
        </tr>
        <tr>
            <th class="bg-light">Status</th>
            <td>
                @if (Model.Allowance.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </td>
        </tr>
    </table>

    <h6 class="font-weight-bold mb-2">Assigned Employees (@Model.Employees.Count)</h6>
    @if (Model.Employees.Any())
    {
        <table class="table table-sm table-bordered table-striped">
            <thead class="bg-light">
                <tr>
                    <th>Employee ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model.Employees)
                {
                    <tr>
                        <td>@emp.EmployeeIdNumber</td>
                        <td>@emp.EmployeeName</td>
                        <td>@(emp.OrganizationUnitName ?? "—")</td>
                        <td>@(emp.DesignationName ?? "—")</td>
                        <td class="text-center">
                            @if (emp.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No employees are assigned to this allowance.</p>
    }
</div>

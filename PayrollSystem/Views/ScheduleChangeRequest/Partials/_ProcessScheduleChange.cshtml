@using PayrollSystem.Utility
@model ScheduleChangeProcessViewModel

<link rel="stylesheet" href="~/css/dtr-modals.css" asp-append-version="true" />

<form id="scheduleChangeProcessForm" method="post" asp-action="Process" asp-controller="ScheduleChangeRequest">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ReviewAction" />

    <div class="dm-modal">
        <div class="dm-process-header">
            <div>
                <h6>@EnumHelper.GetDisplayName(Model.ReviewAction) schedule change</h6>
                <small>@Model.DateDisplay</small>
            </div>
            <span class="dm-status @(Model.ReviewAction == JustificationStatus.Approved ? "dm-status--approved" : "dm-status--rejected")">
                @Model.ReviewAction
            </span>
        </div>

        <div class="dm-section">
            <div class="dm-section-header">
                <i class="fas fa-user"></i>
                Request summary
            </div>
            <div class="dm-section-body">
                @await Html.PartialAsync("~/Views/Shared/Partials/_ProcessRequestSummary.cshtml", Model.Summary)

                <div class="dm-detail-grid dm-detail-grid--compact mt-3">
                    <div class="dm-detail-item dm-detail-item--full">
                        <span class="dm-detail-label">Schedule date</span>
                        <span class="dm-detail-value">@Model.DateDisplay</span>
                    </div>
                </div>

                <div class="dm-shift-compare mt-3">
                    <div class="dm-shift-card dm-shift-card--current">
                        <span class="dm-shift-card-label">Current</span>
                        <span class="dm-shift-code" style="border-color: @Model.CurrentShiftColorHex; color: @Model.CurrentShiftColorHex">
                            @Model.CurrentShiftCode
                        </span>
                        <span class="dm-shift-name">@Model.CurrentShiftLabel</span>
                    </div>
                    <div class="dm-shift-arrow" aria-hidden="true">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                    <div class="dm-shift-card dm-shift-card--requested">
                        <span class="dm-shift-card-label">Requested</span>
                        <span class="dm-shift-code" style="border-color: @Model.RequestedShiftColorHex; color: @Model.RequestedShiftColorHex">
                            @Model.RequestedShiftCode
                        </span>
                        <span class="dm-shift-name">@Model.RequestedShiftLabel</span>
                    </div>
                </div>

                <div class="mt-3">
                    <span class="dm-detail-label d-block mb-1">Reason</span>
                    <p class="dm-reason-box mb-0">@Model.Reason</p>
                </div>
            </div>
        </div>

        <div class="dm-section">
            <div class="dm-section-header">
                <i class="fas fa-sticky-note"></i>
                Reviewer notes
            </div>
            <div class="dm-section-body">
                @if (Model.ReviewAction == JustificationStatus.Rejected)
                {
                    <div class="dm-alert-banner dm-alert-banner--warning mb-3">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>Please provide a reason when rejecting this request.</div>
                    </div>
                    <label asp-for="ReviewNotes" class="dm-form-label">Rejection notes</label>
                    <textarea asp-for="ReviewNotes"
                              class="form-control dm-form-control"
                              rows="3"
                              required
                              placeholder="Enter reason for rejection…"></textarea>
                    <span asp-validation-for="ReviewNotes" class="text-danger validation-message"></span>
                }
                else
                {
                    <label asp-for="ReviewNotes" class="dm-form-label">Notes (optional)</label>
                    <textarea asp-for="ReviewNotes"
                              class="form-control dm-form-control"
                              rows="2"
                              placeholder="Optional internal notes…"></textarea>
                }
            </div>
        </div>
    </div>
</form>

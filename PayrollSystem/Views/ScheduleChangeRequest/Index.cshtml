@using PayrollSystem.Utility
@model List<ScheduleChangeRequestListViewModel>
@{
    ViewData["Title"] = "Schedule Change Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.ActiveMenu = "AttendanceMonitoring";
    ViewBag.ActiveLink = "ScheduleChangeRequest";

    var filterStatus = ViewBag.FilterStatus as JustificationStatus?;
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var approvedCount = (int)(ViewBag.ApprovedCount ?? 0);
    var rejectedCount = (int)(ViewBag.RejectedCount ?? 0);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var hasItems = Model != null && Model.Any();
}

<link rel="stylesheet" href="~/css/approval-workflow.css" asp-append-version="true" />

<section class="content aw-page aw-queue-page">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-outline rounded-0 card-primary mx-2 px-2">
                    <div class="card-header d-flex align-items-center flex-wrap gap-2">
                        <div class="flex-grow-1">
                            <h3 class="card-title m-0">Schedule Change Requests</h3>
                            <p class="aw-intro mt-1 mb-0">
                                Review employee requests to change assigned shifts on specific work schedule dates.
                            </p>
                        </div>
                        @if (pendingCount > 0)
                        {
                            <span class="badge badge-warning badge-pill px-3 py-2">
                                @pendingCount pending
                            </span>
                        }
                    </div>

                    <div class="card-body">
                        @if (!hasItems)
                        {
                            <div class="aw-empty-state">
                                <i class="fas fa-calendar-alt d-block"></i>
                                <h5>No schedule change requests</h5>
                                <p class="mb-0">
                                    @if (filterStatus.HasValue)
                                    {
                                        @:No @EnumHelper.GetDisplayName(filterStatus.Value).ToLower() requests found.
                                    }
                                    else
                                    {
                                        @:There are no schedule change requests yet.
                                    }
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="aw-pending-toolbar aw-pending-toolbar--row">
                                <div class="aw-pending-search">
                                    <i class="fas fa-search"></i>
                                    <input type="search"
                                           id="approvalQueueSearch"
                                           class="form-control form-control-sm"
                                           placeholder="Search employee, shift, reason…"
                                           autocomplete="off" />
                                </div>
                                <div class="aw-pending-filters">
                                    <a asp-action="Index"
                                       asp-route-status="@((int?)JustificationStatus.Pending)"
                                       class="aw-filter-pill @(filterStatus == JustificationStatus.Pending ? "is-active" : "")">
                                        Pending <span class="aw-filter-count">@pendingCount</span>
                                    </a>
                                    <a asp-action="Index"
                                       asp-route-status="@((int?)JustificationStatus.Approved)"
                                       class="aw-filter-pill @(filterStatus == JustificationStatus.Approved ? "is-active" : "")">
                                        Approved <span class="aw-filter-count">@approvedCount</span>
                                    </a>
                                    <a asp-action="Index"
                                       asp-route-status="@((int?)JustificationStatus.Rejected)"
                                       class="aw-filter-pill @(filterStatus == JustificationStatus.Rejected ? "is-active" : "")">
                                        Rejected <span class="aw-filter-count">@rejectedCount</span>
                                    </a>
                                    <a asp-action="Index"
                                       asp-route-status=""
                                       class="aw-filter-pill @(!filterStatus.HasValue ? "is-active" : "")">
                                        All <span class="aw-filter-count">@totalCount</span>
                                    </a>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover table-striped table-bordered aw-pending-table" id="approvalQueueTable" width="100%">
                                    <thead>
                                        <tr class="text-center">
                                            <th>Employee</th>
                                            <th>Date</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Reason</th>
                                            <th>Status</th>
                                            <th>Submitted</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model!)
                                        {
                                            var statusBadge = item.Status switch
                                            {
                                                JustificationStatus.Pending => "badge-warning",
                                                JustificationStatus.Approved => "badge-success",
                                                JustificationStatus.Rejected => "badge-danger",
                                                _ => "badge-secondary"
                                            };
                                            var badgeText = item.Status switch
                                            {
                                                JustificationStatus.Pending when item.CurrentStepOrder == 1 => "Pending (Step 1: Org Approver)",
                                                JustificationStatus.Pending when item.CurrentStepOrder == 2 => "Pending (Step 2: HR Approver)",
                                                _ => EnumHelper.GetDisplayName(item.Status)
                                            };
                                            <tr data-queue-row>
                                                <td>
                                                    <span class="aw-queue-employee">@item.EmployeeName</span>
                                                    <div class="aw-queue-meta">@item.EmployeeIdNumber</div>
                                                </td>
                                                <td class="text-center">@item.Month/@item.Day/@item.Year</td>
                                                <td class="text-center"><span class="badge badge-light border">@item.CurrentShiftCode</span></td>
                                                <td class="text-center"><span class="badge badge-info">@item.RequestedShiftCode</span></td>
                                                <td>@item.Reason</td>
                                                <td class="text-center"><span class="badge @statusBadge">@badgeText</span></td>
                                                <td class="text-center">
                                                    <div class="small">@item.SubmittedBy</div>
                                                    <div class="aw-queue-meta">@item.SubmittedOn.ToString("MMM dd, yyyy hh:mm tt")</div>
                                                </td>
                                                <td class="text-center">
                                                    @if (item.ApprovalRequestId.HasValue)
                                                    {
                                                        if (item.Status == JustificationStatus.Pending && item.CanReview)
                                                        {
                                                            <div class="btn-group btn-group-sm aw-action-group">
                                                                <a href="javascript:void(0)"
                                                                   class="btn btn-success open-modal"
                                                                   data-title="Approve Schedule Change"
                                                                   data-url="@Url.Action("Process", "ScheduleChangeRequest", new { id = item.Id, status = JustificationStatus.Approved })"
                                                                   data-modal-type="create"
                                                                   data-size="modal-lg">
                                                                    Approve
                                                                </a>
                                                                <a href="javascript:void(0)"
                                                                   class="btn btn-outline-danger open-modal"
                                                                   data-title="Reject Schedule Change"
                                                                   data-url="@Url.Action("Process", "ScheduleChangeRequest", new { id = item.Id, status = JustificationStatus.Rejected })"
                                                                   data-modal-type="create"
                                                                   data-size="modal-lg">
                                                                    Reject
                                                                </a>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <a href="javascript:void(0)"
                                                               class="btn btn-sm btn-outline-secondary open-modal"
                                                               data-title="Schedule Change Logs"
                                                               data-url="@Url.Action("Review", "ScheduleChangeRequest", new { id = item.Id })"
                                                               data-modal-type="view"
                                                               data-size="modal-xl">
                                                                <i class="fas fa-history mr-1"></i> View Logs
                                                            </a>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/approval-queue-list.js" asp-append-version="true"></script>
}

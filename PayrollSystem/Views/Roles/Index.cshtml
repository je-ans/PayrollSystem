@model IEnumerable<ApplicationRole>

@{
	ViewData["Title"] = "Roles";
	ViewBag.ActiveMenu = "SystemSetting";
	ViewBag.ActiveLink = "Roles";
}

<div class="card card-outline rounded-0 card-primary mx-2 px-2">
	<div class="card-header d-flex align-items-center">
		<div class="flex-grow-1 d-flex justify-content-start">
			<h3 class="card-title m-0">Roles List</h3>
		</div>
		<div class="card-tools d-flex align-items-center">
			<a href="javascript:void(0)" class="btn btn-primary open-modal"
			   data-title="Add Role"
			   data-url="/Roles/CreateRole"
			   data-modal-type="create"
			   data-toogle="tooltip"
			   title="Add Role">
				<i class="fas fa-plus"></i>
				<span class="d-none d-lg-inline">Add Role</span>
			</a>
		</div>
	</div>

	<div class="card-body">
		<div class="container-fluid">
			<table class="table table-hover table-striped table-bordered" id="myTable" width="100%">
				<thead>
					<tr class="text-center">
						<th>No.</th>
						<th>Role Name</th>
						<th>Description</th>
						<th>Status</th>
						<th>Role Rights</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.Any())
					{
						int counter = 1;
						foreach (var item in Model)
						{
							<tr>
								<td class="text-center">@counter</td>
								<td>@item.Name</td>
								<td>@item.Description</td>
								<td class="text-center">
									<span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
										<i class="@(item.IsActive ? "fa fa-check-circle text-white" : "fa fa-times-circle text-white")"></i>
										@(item.IsActive ? "Active" : "Inactive")
									</span>
								</td>
								<td class="text-center">
									<button type="button" class="btn btn-sm btn-warning open-modal"
											data-title="Manage Role Rights"
											data-url="/AssignRolePermission/UserRights/@item.Id" data-modal-type="create">
										<span class="fas fa-user-shield"></span> Assign Rights
									</button>
								<td class="text-center">
									<button type="button" class="btn btn-flat p-1 btn-default btn-sm dropdown-toggle dropdown-icon" data-toggle="dropdown">
										Action
										<span class="sr-only">Toggle Dropdown</span>
									</button>
									<div class="dropdown-menu" role="menu">
										<a href="javascript:void(0)" class="dropdown-item open-modal" 
											data-title="Role Details" 
											data-url="/Roles/ViewRole/@item.Id" 
											data-modal-type="view">
											<i class="fa fa-eye mr-2 text-dark"></i>
											<span>View Role</span>
										</a>
										<div class="dropdown-divider"></div>
										<a href="javascript:void(0)" class="dropdown-item open-modal" 
											data-title="Edit Role" 
											data-url="/Roles/EditRole/@item.Id" 
											data-modal-type="edit">
											<i class="fa fa-edit mr-2 text-primary"></i>
											<span>Edit Role</span>
										</a>
										<div class="dropdown-divider"></div>
										<a href="javascript:void(0)" class="dropdown-item open-modal" 
                                           data-title="Delete Role" 
                                           data-url="/Roles/DeleteRole/@item.Id" 
                                           data-modal-type="@(ViewBag.RolesWithUsers?.Contains(item.Id) == true ? "view" : "delete_data")"
                                           data-size="@(ViewBag.RolesWithUsers?.Contains(item.Id) == true ? "modal-lg" : "")">
											<i class="fa fa-trash mr-2 text-danger"></i>
											<span>Delete Role</span>
										</a>
									</div>
								</td>
							</tr>
							counter++;
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

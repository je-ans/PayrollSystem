@model RolesViewModel

<div class="container-fluid">
    <span asp-validation-summary="ModelOnly" class="text-danger"></span>
    <form asp-action="CreateRole" method="post" asp-antiforgery="true">
        <div class="form-group">
            <div class="input-container">
                <input asp-for="RoleName" type="text" class="form-control floating-input" required placeholder=" ">
                <label asp-for="RoleName" class="floating-label">Role Name</label>
            </div>
            <span asp-validation-for="RoleName" class="text-danger validation-message"></span>
        </div>

        <div class="form-group">
            <div class="input-container">
                <input asp-for="Description" type="text" class="form-control floating-input" required placeholder=" ">
                <label asp-for="Description" class="floating-label">Description</label>
            </div>
            <span asp-validation-for="Description" class="text-danger validation-message"></span>
        </div>
    </form>
</div>


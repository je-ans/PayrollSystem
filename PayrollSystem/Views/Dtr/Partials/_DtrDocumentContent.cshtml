@model DtrViewModel

@{
    Layout = null;
}

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 10px;
        }

        .dtr-page {
            display: flex;
            gap: 10px;
            width: 100%;
            max-width: 100%;
        }

        .dtr-container {
            flex: 1;
            border: 1.8px solid #000;
            padding: 12px;
            width: 49%;
        }

        .dtr-form-header {
            text-align: center;
            margin-bottom: 8px;
        }

        .dtr-form-number {
            font-size: 10pt;
            margin-bottom: 2px;
        }

        .dtr-form-title {
            font-weight: bold;
            font-size: 12pt;
            margin: 2px 0;
            text-decoration: underline;
        }

        .dtr-employee-name {
            font-weight: bold;
            text-transform: uppercase;
            font-size: 11pt;
            margin: 4px 0 2px 0;
            text-decoration: underline;
        }

        .dtr-name-label {
            font-size: 9pt;
            font-style: italic;
        }

        .dtr-month-year {
            font-size: 9pt;
            margin: 4px 0;
        }

        .dtr-hours-info {
            font-size: 8pt;
            margin-top: 6px;
            text-align: left;
            display: flex;
            justify-content: space-between;
            padding: 0 5px;
        }

        .dtr-table-content {
            font-size: 8.5pt;
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
        }

        .dtr-table-content th,
        .dtr-table-content td {
            border: 1px solid #000;
            padding: 1px 2px;
            text-align: center;
            vertical-align: middle;
            height: 17px;
        }

        .dtr-table-content th {
            background-color: #ffffff;
            font-weight: bold;
            font-size: 8.5pt;
        }

        .dtr-table-content .col-day {
            width: 7%;
            font-weight: normal;
        }

        .dtr-table-content .col-time {
            width: 15%;
        }

        .dtr-table-content .col-undertime {
            width: 7%;
        }

        .dtr-table-content td {
            font-size: 8.5pt;
        }

        .dtr-table-content .special-day-label {
            font-size: 8.5pt;
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        .dtr-table-content .official-time-label {
            font-size: 8pt;
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        .dtr-footer {
            margin-top: 6px;
            font-size: 8.5pt;
            line-height: 1.35;
        }

        .dtr-footer-line {
            margin: 1px 0;
        }

        .dtr-footer-summary {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            margin-top: 2px;
        }

        .dtr-footer-summary span {
            white-space: nowrap;
        }

        .dtr-total {
            font-weight: bold;
            margin-top: 3px;
        }

        .dtr-certify {
            margin-top: 12px;
            font-size: 9pt;
            line-height: 1.3;
        }

        .dtr-certify p {
            margin: 3px 0;
            text-align: justify;
        }

        .dtr-signature-section {
            margin-top: 12px;
        }

        .dtr-signature-line {
            border-bottom: 1px solid #000;
            margin-top: 20px;
            min-height: 12px;
        }

        .dtr-signature-label {
            font-size: 8pt;
            margin-top: 1px;
            text-align: center;
        }

@@media print {
    @@page {
        size: A4 portrait;
        margin-right: 2mm;
        margin-left: 2mm;
    }

    body {
        margin: 0;
        padding: 0;
    }

    .dtr-page {
        display: flex;
        gap: 6mm;
        width: 100%;
        max-width: 100%;
        padding: 0;
        margin: 0;
    }

    .dtr-container {
        flex: 1;
        border: 1.8px solid #000 !important;
        padding: 10px;
        width: calc(50% - 3mm) !important;
        min-width: 0;
        box-sizing: border-box;
    }

    .dtr-table-content {
        page-break-inside: avoid;
    }

    .dtr-table-content th,
    .dtr-table-content td {
        border: 1px solid #000 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .dtr-certify {
        page-break-inside: avoid;
    }
}
    </style>

    <div class="dtr-page">
        @for (var copy = 0; copy < 2; copy++)
        {
            <div class="dtr-container">
                <div class="dtr-form-header">
                    <div class="dtr-form-number">Civil Service Form No. 48</div>
                    <div class="dtr-form-title">DAILY TIME RECORD</div>
                    <div style="margin-top: 6px;">
                        <div class="dtr-employee-name">@Model.EmployeeName</div>
                        <div class="dtr-name-label">(Name)</div>
                    </div>
                    <div class="dtr-month-year">For the month of @Model.MonthYear</div>
                </div>

                <div class="dtr-hours-info">
                    <div>
                        <span style="font-style: italic;">Official hours for arrival and departure</span>
                    </div>
                    <div>
                        <span>Regular days: @Model.RegularDaysHours</span>
                    </div>
                    <div>
                        <span>Saturdays: @Model.SaturdaysHours</span>
                    </div>
                </div>

                <table class="dtr-table-content">
                    <thead>
                        <tr>
                            <th rowspan="2" class="col-day">Day</th>
                            <th colspan="2">A.M.</th>
                            <th colspan="2">P.M.</th>
                            <th colspan="2">Tardiness/Undertime</th>
                        </tr>
                        <tr>
                            <th class="col-time">Arrival</th>
                            <th class="col-time">Departure</th>
                            <th class="col-time">Arrival</th>
                            <th class="col-time">Departure</th>
                            <th class="col-undertime">Hrs</th>
                            <th class="col-undertime">Mins</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.DayRows)
                        {
                            <tr>
                                <td class="col-day">@row.Day</td>
                                @if (row.ShowScheduledLeaveWithLogs)
                                {
                                    <td class="col-time">@row.AmArrival</td>
                                    <td class="col-time">@row.AmDeparture</td>
                                    <td colspan="2" class="special-day-label">@row.SpecialDayLabel</td>
                                    <td class="col-undertime">@row.TardinessUndertimeHrs</td>
                                    <td class="col-undertime">@row.TardinessUndertimeMins</td>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.SpecialDayLabel))
                                {
                                    <td colspan="4" class="special-day-label">@row.SpecialDayLabel</td>
                                    <td class="col-undertime">@row.TardinessUndertimeHrs</td>
                                    <td class="col-undertime">@row.TardinessUndertimeMins</td>
                                }
                                else if (row.ShowFlexibleOfficialTime)
                                {
                                    <td class="col-time">@row.AmArrival</td>
                                    <td colspan="2" class="official-time-label">@row.FlexibleOfficialTimeLabel</td>
                                    <td class="col-time">@row.PmDeparture</td>
                                    <td class="col-undertime">@row.TardinessUndertimeHrs</td>
                                    <td class="col-undertime">@row.TardinessUndertimeMins</td>
                                }
                                else
                                {
                                    <td class="col-time">@row.AmArrival</td>
                                    <td class="col-time">@row.AmDeparture</td>
                                    <td class="col-time">@row.PmArrival</td>
                                    <td class="col-time">@row.PmDeparture</td>
                                    <td class="col-undertime">@row.TardinessUndertimeHrs</td>
                                    <td class="col-undertime">@row.TardinessUndertimeMins</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="dtr-footer">
                    <div class="dtr-footer-summary">
                        <span>Tardiness : @Model.TardinessMinutes</span>
                        <span>Undertime : @Model.UndertimeMinutes mins</span>
                    </div>
                    <div class="dtr-footer-summary">
                        <span>Frequency : @Model.TardinessFrequency</span>
                        <span>Frequency : @Model.UndertimeFrequency times</span>
                    </div>
                    <div class="dtr-footer-line">Legend: ** (User Provided Logs)</div>
                    <div class="dtr-total">Total : @Model.TotalDays.ToString("N3")</div>
                </div>

                <div class="dtr-certify">
                    <p>
                        I certify on my honor that the above is a true and correct report of the hours
                        of work performed, record of which was made daily at the time of arrival and
                        departure from office.
                    </p>

                    <div class="dtr-signature-section">
                        <div class="dtr-signature-line" style="width: 55%; margin: 0 auto;"></div>
                        <div class="dtr-signature-label">(Name)</div>
                    </div>

                    <div style="margin-top: 15px; font-size: 9pt; font-style: italic;">
                        VERIFIED as to the prescribed office hours:
                    </div>

                    <div class="dtr-signature-section">
                        <div class="dtr-signature-line" style="width: 55%; margin: 0 auto;"></div>
                        <div class="dtr-signature-label">In Charge</div>
                    </div>
                </div>
            </div>
        }
    </div>

@model OrganizationStructureViewModel

@{
    var accent = OrganizationStructureDisplayHelper.GetLevelAccentClass(Model.Level);
    var icon = OrganizationStructureDisplayHelper.GetLevelIcon(Model.Level);
}

<div class="container-fluid">
    <div class="d-flex align-items-start gap-3 mb-3" style="gap:0.85rem;">
        <div class="org-tree-icon @accent"><i class="fas @icon"></i></div>
        <div>
            <h5 class="mb-1 font-weight-bold">@Model.Name</h5>
            <div class="org-unit-badges">
                <span class="org-unit-badge"><i class="fas fa-barcode"></i> @Model.Code</span>
                <span class="org-unit-badge"><i class="fas fa-layer-group"></i> @Model.LevelDisplayName</span>
                <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </div>
        </div>
    </div>

    <dl class="row mb-0 small">
        <dt class="col-sm-4 text-muted">Parent</dt>
        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.ParentName) ? "— (root)" : Model.ParentName)</dd>
    </dl>

    <div class="mt-3 text-right">
        <a asp-action="Unit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
            <i class="fas fa-sliders-h mr-1"></i> Manage Unit
        </a>
    </div>
</div>

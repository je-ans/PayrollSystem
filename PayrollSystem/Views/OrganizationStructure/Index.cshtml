@model OrganizationStructureIndexViewModel

@{
    ViewData["Title"] = "Organization Structure";
    ViewBag.ActiveMenu = "OrganizationStructure";
    ViewBag.ActiveLink = "OrganizationStructure";
    ViewBag.ActiveMainMenu = "BuildUp";
}

<link rel="stylesheet" href="~/css/organization-structure.css" asp-append-version="true" />

<section class="content org-page">
    <div class="container-fluid">
        <div class="card card-outline rounded-0 card-primary mx-2 px-2">
            <div class="card-header d-flex align-items-center flex-wrap gap-2">
                <div class="flex-grow-1">
                    <h3 class="card-title m-0">Organization Structure</h3>
                    <p class="org-intro mt-1">Build your org hierarchy and assign staff, leaders, and approver roles per unit.</p>
                </div>
                <div class="card-tools d-flex flex-wrap gap-1" asp-permission="ORGANIZATIONSTRUCTURE_VIEW">
                    @if (Model.Roots != null && Model.Roots.Any())
                    {
                        <a asp-action="Chart" class="btn btn-outline-primary">
                            <i class="fas fa-project-diagram"></i>
                            <span class="d-none d-lg-inline ml-1">View Chart</span>
                        </a>
                    }
                    <a href="javascript:void(0)" class="btn btn-primary open-modal"
                       data-title="Add Organization Unit"
                       data-url="@Url.Action("Create")"
                       data-modal-type="create">
                        <i class="fas fa-plus"></i>
                        <span class="d-none d-lg-inline ml-1">Add Unit</span>
                    </a>
                </div>
            </div>

            <div class="card-body">
                @if (Model.Roots != null && Model.Roots.Any())
                {
                    <div class="org-toolbar">
                        <div class="org-search">
                            <i class="fas fa-search"></i>
                            <input type="search" id="orgTreeSearch" class="form-control form-control-sm"
                                   placeholder="Search units by name, code, or level…" />
                        </div>
                        <div class="org-stats">
                            <span class="org-stat-pill"><i class="fas fa-sitemap"></i> @Model.TotalCount unit@(Model.TotalCount == 1 ? "" : "s")</span>
                            <span class="org-stat-pill"><i class="fas fa-circle text-primary" style="font-size:0.45rem"></i> Staff assigned</span>
                            <span class="org-stat-pill"><i class="fas fa-circle" style="font-size:0.45rem;color:#7c3aed"></i> Roles assigned</span>
                        </div>
                    </div>

                    <div class="org-tree" id="orgTree">
                        @await Html.PartialAsync("_OrgTree", Model.Roots)
                    </div>
                    <p class="text-muted small mt-3 mb-0" id="orgTreeNoResults" style="display:none;">
                        No units match your search.
                    </p>
                }
                else
                {
                    <div class="org-empty-state">
                        <div><i class="fas fa-sitemap d-block"></i></div>
                        <h5>No organization units yet</h5>
                        <p class="mb-3">Start with an <strong>Institution</strong> root, then add departments and other levels beneath it.</p>
                        <a href="javascript:void(0)" class="btn btn-primary open-modal"
                           data-title="Add Organization Unit"
                           data-url="@Url.Action("Create")"
                           data-modal-type="create"
                           asp-permission="ORGANIZATIONSTRUCTURE_VIEW">
                            <i class="fas fa-plus mr-1"></i> Add First Unit
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/organization-structure.js" asp-append-version="true"></script>
}

@{
    ViewData["Title"] = "Employee";
    ViewBag.ActiveMenu = "EmployeeManagement";
    ViewBag.ActiveLink = "Employee";
    ViewBag.ActiveMainMenu = "EmployeeManagement";
}

<link rel="stylesheet" href="~/css/filter.css" />

<div class="card card-outline rounded-0 card-primary mx-2 px-2">
    <div class="card-header d-flex align-items-center">
        <div class="flex-grow-1 d-flex justify-content-start">
            <h3 class="card-title m-0">Employee List</h3>
        </div>
        <div class="card-tools d-flex align-items-center">
            @* <button type="button" class="btn btn-outline-info mr-2" *@
            @*         id="toggleFilters" *@
            @*         data-toggle="tooltip" *@
            @*         title="Filters"> *@
            @*     <i class="fas fa-filter mr-1"></i> *@
            @*     <span class="d-none d-lg-inline">Filters</span> *@
            @* </button> *@
            <a href="javascript:void(0)" class="btn btn-primary open-modal"
               data-title="Add Employee Account"
               data-url="/Employee/CreateEmployee"
               data-modal-type="create"
               data-toggle="tooltip"
               title="Add Employee (creates login account)">
                <i class="fas fa-user-plus"></i>
                <span class="d-none d-lg-inline">Add Employee Account</span>
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="container-fluid">

            <!-- Filter Section -->
            <div class="filter-section collapsed" id="filterSection">
                <div class="filter-header" id="filterHeader">
                    <div>
                        <i class="fas fa-filter mr-2"></i>
                        <span class="font-weight-bold">Advanced Filters</span>
                    </div>
                    <button type="button" class="filter-toggle" id="filterToggle">
                        <i class="fas fa-chevron-down"></i>
                    </button>
                </div>
                <div class="filter-body" id="filterBody">
                    <div class="row">

                        <!-- Employee ID field -->
                        <div class="filter-group col-12 col-sm-6 col-md-4 col-lg-2">
                            <label class="filter-label">Employee ID</label>
                            <input type="text" class="form-control filter-input" id="employeeIdFilter" placeholder="Enter employee ID">
                        </div>

                        <!-- Full Name dropdown -->
                        <div class="filter-group col-12 col-sm-6 col-md-4 col-lg-3">
                            <label class="filter-label">Employee Name</label>
                            <select class="form-control filter-input select2" id="fullNameFilter">
                                <option value="">-- All --</option>
                                @if (ViewBag.Employees != null)
                                {
                                    foreach (var emp in ViewBag.Employees)
                                    {
                                        <option value="@emp.FullName">@emp.FullName</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Designation dropdown -->
                        <div class="filter-group col-12 col-sm-6 col-md-4 col-lg-2">
                            <label class="filter-label">Designation</label>
                            <select class="form-control filter-input select2" id="designationFilter">
                                <option value="">-- All --</option>
                                @if (ViewBag.Designations != null)
                                {
                                    foreach (var d in ViewBag.Designations)
                                    {
                                        <option value="@d.Id">@d.DesignationName</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Organization unit dropdown -->
                        <div class="filter-group col-12 col-sm-6 col-md-4 col-lg-3">
                            <label class="filter-label">Organization Unit</label>
                            <select class="form-control filter-input select2" id="organizationStructureFilter">
                                <option value="">-- All --</option>
                                @if (ViewBag.OrganizationUnits != null)
                                {
                                    foreach (var u in ViewBag.OrganizationUnits)
                                    {
                                        <option value="@u.Id">@u.DisplayText</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Status dropdown -->
                        <div class="filter-group col-12 col-sm-6 col-md-4 col-lg-2">
                            <label class="filter-label">Status</label>
                            <select class="form-control filter-input select2" id="statusFilter">
                                <option value="">-- All --</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>

                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="d-flex flex-wrap flex-md-nowrap gap-2 justify-content-end align-items-center responsive-btn-group">
                                <button type="button" class="btn btn-outline-secondary mb-2 mb-md-0" id="clearFilters">
                                    <i class="fas fa-times mr-2"></i>Clear Filters
                                </button>
                                <button type="button" class="btn btn-primary mb-2 mb-md-0 me-md-2" id="applyFilters">
                                    <i class="fas fa-filter mr-2"></i>Apply Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (ViewBag.FilterEmploymentBasis != null)
            {
                <div class="alert alert-info py-2 mb-3 d-flex align-items-center justify-content-between" id="employmentBasisBanner">
                    <span>
                        <i class="fas fa-filter mr-1"></i>
                        Showing <strong>@ViewBag.FilterEmploymentBasis</strong> employees
                        <span class="text-muted">(from dashboard)</span>
                    </span>
                    <a href="@Url.Action("Index", "Employee")" class="btn btn-sm btn-outline-secondary">Clear</a>
                </div>
            }

            <!-- Active Filters Display -->
            <div class="active-filters" id="activeFilters" style="display: none;">
                <div class="no-filters">No active filters</div>
            </div>

            <table class="table table-hover table-striped table-bordered" id="employeeTable" width="100%">
                <thead>
                    <tr class="text-center">
                        <th>No.</th>
                        <th>Employee ID</th>
                        <th>Full Name</th>
                        <th>Designation</th>
                        <th>Organization Unit</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        let dataTable;
        let activeFilters = {};
        const dashboardEmploymentBasis = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string?)ViewBag.FilterEmploymentBasis));

        $(document).ready(function () {
            loadFiltersFromLocalStorage();
            if (dashboardEmploymentBasis) {
                activeFilters.employmentBasis = dashboardEmploymentBasis;
                // Match dashboard pie: active employees for that employment basis
                if (!activeFilters.status) {
                    activeFilters.status = 'true';
                    $('#statusFilter').val('true');
                }
            }
            initializeDataTable();
            initializeFilterSystem();
            initializeSelect2();
        });

        function initializeSelect2() {
            $('.select2').select2({
                theme: 'bootstrap4',
                width: '100%',
                allowClear: true,
                placeholder: '-- All --'
            });

            // Re-sync activeFilters when Select2 changes a value
            $('.select2').on('select2:select select2:unselect', function () {
                // Optional: auto-apply on change, or let user click Apply manually
            });
        }

        // ─── DataTable ───────────────────────────────────────────────────────────────

        function initializeDataTable() {
            if ($.fn.DataTable.isDataTable('#employeeTable')) {
                dataTable = $('#employeeTable').DataTable();
                return;
            }

            dataTable = $('#employeeTable').DataTable({
                responsive: true,
                lengthChange: true,
                autoWidth: false,
                pageLength: 25,
                processing: true,
                serverSide: true,
                order: [[2, 'asc']],
                ajax: {
                    url: '/Employee/GetEmployeesJson',
                    type: 'POST',
                    datatype: 'json',
                    data: function (d) {
                        d.employeeId    = activeFilters.employeeId    || '';
                        d.fullName      = activeFilters.fullName      || '';
                        d.designationId = activeFilters.designationId || '';
                        d.organizationStructureId = activeFilters.organizationStructureId || '';
                        d.status        = activeFilters.status        || '';
                        d.employmentBasis = activeFilters.employmentBasis || '';
                    },
                    dataSrc: function (json) {
                        return json.data;
                    }
                },
                columns: [
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        },
                        className: 'text-center',
                        orderable: false
                    },
                    { data: 'employeeIdNumber', defaultContent: '' },
                    { data: 'fullName',         defaultContent: '' },
                    { data: 'designationName',  defaultContent: '' },
                    { data: 'organizationUnitName', defaultContent: '' },
                    {
                        data: 'isActive',
                        className: 'text-center',
                        render: function (data) {
                            return data
                                ? '<span class="badge badge-success"><i class="fa fa-check-circle"></i> Active</span>'
                                : '<span class="badge badge-danger"><i class="fa fa-times-circle"></i> Inactive</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        className: 'text-center',
                        render: function (data, type, row) {
                            return `
                                <div class="btn-group">
                                    <button type="button"
                                            class="btn btn-flat p-1 btn-default btn-sm dropdown-toggle dropdown-icon"
                                            data-toggle="dropdown">
                                        Action <span class="sr-only">Toggle Dropdown</span>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right" role="menu">
                                        <a href="javascript:void(0)" class="dropdown-item open-modal"
                                           data-title="Employee Details"
                                           data-url="/Employee/ViewEmployee/${row.id}"
                                           data-modal-type="view">
                                            <i class="fa fa-eye mr-2 text-dark"></i> View Employee
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a href="javascript:void(0)" class="dropdown-item open-modal"
                                           data-title="Edit Employee"
                                           data-url="/Employee/EditEmployee/${row.id}"
                                           data-modal-type="edit">
                                            <i class="fa fa-edit mr-2 text-primary"></i> Edit Employee
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a href="javascript:void(0)" class="dropdown-item open-modal"
                                           data-title="Delete Employee"
                                           data-url="/Employee/DeleteEmployee/${row.id}"
                                           data-modal-type="delete_data">
                                            <i class="fa fa-trash mr-2 text-danger"></i> Delete Employee
                                        </a>
                                    </div>
                                </div>`;
                        }
                    }
                ],
                columnDefs: [
                    { targets: [0, 5, 6], orderable: false }
                ],
                language: {
                    search: 'Quick Search:',
                    lengthMenu: 'Show _MENU_ entries per page',
                    info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                    infoEmpty: 'Showing 0 to 0 of 0 entries',
                    infoFiltered: '(filtered from _MAX_ total entries)',
                    zeroRecords: 'No matching records found',
                    processing: "<i class='fas fa-spinner fa-spin'></i> Loading..."
                }
            });
        }

        // ─── Filter System ────────────────────────────────────────────────────────────

        function initializeFilterSystem() {
            $('#toggleFilters, #filterHeader').on('click', function () {
                $('#filterSection').toggleClass('collapsed');
                $('#filterToggle').toggleClass('rotated');

                if (!$('#filterSection').hasClass('collapsed')) {
                    setTimeout(() => $('#employeeIdFilter').focus(), 300);
                }
            });

            $('#applyFilters').on('click', function () { applyFilters(); });
            $('#clearFilters').on('click', function () { clearAllFilters(); });

            $('.filter-input').on('keypress', function (e) {
                if (e.which === 13) applyFilters();
            });

            updateActiveFiltersDisplay();
        }

        function loadFiltersFromLocalStorage() {
            const saved = JSON.parse(localStorage.getItem('employeeFilters') || '{}');
            activeFilters = saved;

            if ($('#employeeIdFilter').length)   $('#employeeIdFilter').val(saved.employeeId    || '');
            if ($('#fullNameFilter').length)     $('#fullNameFilter').val(saved.fullName        || '').trigger('change');
            if ($('#designationFilter').length)  $('#designationFilter').val(saved.designationId || '').trigger('change');
            if ($('#organizationStructureFilter').length) $('#organizationStructureFilter').val(saved.organizationStructureId || '').trigger('change');
            if ($('#statusFilter').length)       $('#statusFilter').val(saved.status            || '').trigger('change');

            if ($('#activeFilters').length) updateActiveFiltersDisplay();

            if (Object.keys(saved).length > 0 && $('#filterSection').length) {
                $('#filterSection').removeClass('collapsed');
                $('#filterToggle').addClass('rotated');
            }
        }

        function applyFilters() {
            const preservedBasis = activeFilters.employmentBasis;
            const filters = {
                employeeId:    $('#employeeIdFilter').val().trim(),
                fullName:      $('#fullNameFilter').val(),
                designationId: $('#designationFilter').val(),
                organizationStructureId: $('#organizationStructureFilter').val(),
                status:        $('#statusFilter').val()
            };

            activeFilters = {};
            Object.keys(filters).forEach(key => {
                if (filters[key]) activeFilters[key] = filters[key];
            });
            if (preservedBasis) activeFilters.employmentBasis = preservedBasis;

            localStorage.setItem('employeeFilters', JSON.stringify(activeFilters));
            dataTable.ajax.reload();
            updateActiveFiltersDisplay();
        }

        function clearAllFilters() {
            if (dashboardEmploymentBasis) {
                window.location.href = '@Url.Action("Index", "Employee")';
                return;
            }
            $('#employeeIdFilter').val('');
            $('.select2').val(null).trigger('change');
            activeFilters = {};
            localStorage.removeItem('employeeFilters');
            dataTable.ajax.reload();
            updateActiveFiltersDisplay();
        }

        function updateActiveFiltersDisplay() {
            const container = $('#activeFilters');
            const noFiltersDiv = container.find('.no-filters');

            if (Object.keys(activeFilters).length === 0) {
                container.hide();
                return;
            }

            container.find('.filter-badge').remove();

            Object.keys(activeFilters).forEach(key => {
                const label = getFilterLabel(key);
                const badge = $(`
                    <div class="filter-badge">
                        <span>${label}</span>
                        <button type="button" class="remove-filter" data-filter="${key}">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>`);
                container.append(badge);
            });

            noFiltersDiv.hide();
            container.show();
        }

        function getFilterLabel(key) {
            const labels = {
                employeeId:    'Employee ID',
                fullName:      'Employee Name',
                designationId: 'Designation',
                organizationStructureId: 'Organization Unit',
                status:        'Status',
                employmentBasis: 'Employment Basis'
            };

            let label = labels[key] || key;
            let value = activeFilters[key];

            // Resolve dropdown display text from selected option
            if (key === 'fullName')      value = $('#fullNameFilter option:selected').text();
            if (key === 'designationId') value = $('#designationFilter option:selected').text();
            if (key === 'organizationStructureId') value = $('#organizationStructureFilter option:selected').text();
            if (key === 'status') {
                if (value === 'true')  value = 'Active';
                if (value === 'false') value = 'Inactive';
            }

            return `${label}: ${value}`;
        }

        $(document).on('click', '.remove-filter', function () {
            const filterKey = $(this).data('filter');
            if (filterKey === 'employmentBasis' && dashboardEmploymentBasis) {
                window.location.href = '@Url.Action("Index", "Employee")';
                return;
            }

            delete activeFilters[filterKey];

            const inputMap = {
                employeeId:    'employeeIdFilter',
                fullName:      'fullNameFilter',
                designationId: 'designationFilter',
                organizationStructureId: 'organizationStructureFilter',
                status:        'statusFilter'
            };

            const inputId = '#' + inputMap[filterKey];
            const el = $(inputId);

            // Use the right reset method depending on whether it's a Select2
            if (el.hasClass('select2')) {
                el.val(null).trigger('change');
            } else {
                el.val('');
            }

            localStorage.setItem('employeeFilters', JSON.stringify(activeFilters));
            dataTable.ajax.reload();
            updateActiveFiltersDisplay();
        });
    </script>
}

@model EmployeeViewModel

<div class="container-fluid p-0">
    <div class="alert alert-warning border-0 mb-4 rounded-0" style="background: linear-gradient(to right, #fff8e1, #ffecb3);">
        <div class="d-flex align-items-center p-3">
            <div class="flex-shrink-0">
                <i class="fas fa-exclamation-triangle fa-2x text-warning"></i>
            </div>
            <div class="flex-grow-1 ml-3">
                <h4 class="alert-heading mb-2 font-weight-bold text-dark">Deletion Restricted</h4>
                <p class="mb-0 text-dark">This employee cannot be deleted because it has active dependencies in the system.</p>
                <hr class="my-2 border-warning">
                <p class="small mb-0 text-dark">Please review and resolve all restrictions listed below before attempting deletion.</p>
            </div>
        </div>
    </div>

    <!-- Employee Summary -->
    <div class="px-3 mb-3">
        <table class="table table-bordered table-hover">
            <tr>
                <th class="bg-light">Employee ID</th>
                <td>@Model.EmployeeIdNumber</td>
            </tr>
            <tr>
                <th class="bg-light">Full Name</th>
                <td>@Model.FullName</td>
            </tr>
            <tr>
                <th class="bg-light">Name Extension</th>
                <td>@Model.NameExtension</td>
            </tr>
        </table>
    </div>

    <!-- Restrictions Card -->
    <div class="card border-0 shadow-lg rounded overflow-hidden">
        <div class="card-header bg-white border-bottom border-warning py-3" style="border-bottom-width: 3px !important;">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="mb-0 text-dark font-weight-bold">
                    <i class="fas fa-lock mr-2 text-warning"></i>
                    Active Restrictions
                </h5>
                <span class="badge badge-warning text-dark">
                    @(ViewBag.HasPersonalInformation ? 1 : 0) Active
                </span>
            </div>
        </div>

        <div class="card-body p-4">
            @if (ViewBag.HasPersonalInformation == true)
            {
                <div class="restriction-item mb-4 p-3 bg-light-warning rounded">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0 pt-1">
                            <i class="fas fa-id-card fa-lg text-danger"></i>
                        </div>
                        <div class="flex-grow-1 ml-3">
                            <div class="d-flex align-items-center mb-1">
                                <h6 class="mb-0 text-danger font-weight-bold mr-2">Personal Information on File</h6>
                            </div>
                            <p class="mb-2 text-muted">This employee has an associated Personal Data Sheet (PDS) record in the system.</p>
                            <div class="bg-white p-2 rounded border">
                                <p class="small mb-0">
                                    <i class="fas fa-info-circle text-info mr-1"></i>
                                    To proceed with deletion, please first delete the employee's personal information record.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .bg-light-warning {
        background-color: rgba(255, 193, 7, 0.08);
    }

    .restriction-item:hover {
        background-color: rgba(255, 193, 7, 0.12);
        transition: background-color 0.2s ease;
    }
</style>